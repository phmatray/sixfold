  "npcs": [
    {
      "id": "rhian",
      "name": "Rhian",
      "model": "npc_sailor",
      "x": 5,
      "z": 3,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#2f6b8a",
      "hair": "#c0582d",
      "dialogue": [
        {
          "if": "!flag:talked_rhian",
          "lines": [
            "Welcome to the Weathervane! Shut the door, the wind's got opinions tonight.",
            "Beds, a fire, and a storm log so you know what you slept through. Rest's free for duellists. Till when?",
            "And if you're buying, the counter has Storm packs and a Fulgurex I keep polished."
          ],
          "lines_fr": [
            "Bienvenue à la Girouette ! Ferme la porte, le vent a des avis, ce soir.",
            "Des lits, un feu, et un journal des tempêtes pour savoir ce que tu as manqué en dormant. Le repos est gratuit pour les duellistes. Jusqu'à quand ?",
            "Et si tu achètes, le comptoir a des boosters Orage et un Fulgurion que je garde bien astiqué."
          ],
          "do": [
            "show:inn"
          ]
        },
        {
          "if": "time:night",
          "lines": [
            "Hear that? Lightning out past the Rodspire. Lovely night for staying in.",
            "Bed?"
          ],
          "lines_fr": [
            "Tu entends ? De la foudre au-delà de l'Aiguille. Belle nuit pour rester au chaud.",
            "Un lit ?"
          ],
          "do": [
            "show:inn"
          ]
        },
        {
          "lines": [
            "Back again! Your bed's where you left it, and so's the wind.",
            "A rest?"
          ],
          "lines_fr": [
            "Te revoilà ! Ton lit est là où tu l'as laissé, le vent aussi.",
            "Tu te reposes ?"
          ],
          "do": [
            "show:inn"
          ]
        }
      ]
    }
  ],
