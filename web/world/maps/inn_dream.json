  "npcs": [
    {
      "id": "mina",
      "name": "Mina",
      "model": "npc_shopkeeper",
      "x": 5,
      "z": 3,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#8a6fb8",
      "hair": "#e8e0d0",
      "dialogue": [
        {
          "if": "!flag:talked_mina",
          "lines": [
            "(whispering) Welcome to the Quiet Lamp. Our guests sleep by day and walk by night, so we keep our voices down.",
            "Rest is free. Till dawn, day, dusk or night: say it softly.",
            "And the counter has Dream packs, and a Hexarch I've never had the heart to sell. Yet."
          ],
          "lines_fr": [
            "(à voix basse) Bienvenue à la Lampe Tranquille. Nos clients dorment le jour et se promènent la nuit, alors on parle doucement.",
            "Le repos est gratuit. Jusqu'à l'aube, au matin, au crépuscule ou à la nuit : dis-le tout bas.",
            "Et au comptoir, des boosters Rêve, et une Sorcarque que je n'ai jamais eu le cœur de vendre. Pour l'instant."
          ],
          "do": [
            "show:inn"
          ]
        },
        {
          "if": "time:night",
          "lines": [
            "(whispering) Everyone's out on the water. The lanterns are up. Lovely night.",
            "A bed, for later?"
          ],
          "lines_fr": [
            "(à voix basse) Tout le monde est sur l'eau. Les lanternes sont levées. Belle nuit.",
            "Un lit, pour plus tard ?"
          ],
          "do": [
            "show:inn"
          ]
        },
        {
          "lines": [
            "(whispering) Shh. Day-sleepers upstairs.",
            "Rest?"
          ],
          "lines_fr": [
            "(à voix basse) Chut. Des dormeurs de jour, en haut.",
            "Te reposer ?"
          ],
          "do": [
            "show:inn"
          ]
        }
      ]
    }
  ],
