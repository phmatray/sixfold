  "spawn": {
    "x": 19,
    "z": 2,
    "facing": "s"
  },
  "interactions": [
    {
      "kind": "sign",
      "text": "North: Lanternmere, by the shore path round the mere.",
      "text_fr": "Nord : Lac-aux-Lanternes, par le chemin de la rive autour du lac.",
      "x": 21,
      "z": 2
    },
    {
      "x": 17,
      "z": 2,
      "kind": "sign",
      "text": "The Moonwell Garden. Please walk softly: the flowers are sleeping. (By day.)",
      "text_fr": "Le Jardin du Puits-de-Lune. Marchez doucement, s'il vous plaît : les fleurs dorment. (Le jour.)"
    },
    {
      "x": 12,
      "z": 3,
      "kind": "sign",
      "id": "seven_stones",
      "name": "Stacked stones",
      "name_fr": "Des pierres empilées",
      "dialogue": [
        {
          "lines": [
            "Seven flat stones, stacked with care outside the garden wall. Six have a dab of colour on them. The top one is blank."
          ],
          "lines_fr": [
            "Sept pierres plates, empilées avec soin devant le mur du jardin. Six portent une touche de couleur. Celle du dessus est vierge."
          ]
        }
      ]
    },
    {
      "x": 22,
      "z": 15,
      "kind": "sign",
      "id": "seal_moonwell",
      "name": "The seal stone",
      "name_fr": "La pierre de sceau",
      "dialogue": [
        {
          "lines": [
            "A hexagonal stone, cool and dewy. Each of its six faces is a colour: the Dream face, turned to the well, shimmers when you look away from it.",
            "The top is smooth, pale and blank, as if something was meant to be cut there and never was."
          ],
          "lines_fr": [
            "Une pierre hexagonale, fraîche et couverte de rosée. Chacune de ses six faces a une couleur : la face Songe, tournée vers le puits, chatoie quand on détourne les yeux.",
            "Le dessus est lisse, pâle et vide, comme si quelque chose devait y être gravé et ne l'avait jamais été."
          ]
        }
      ]
    },
    {
      "kind": "waymark",
      "id": "moonwell",
      "x": 25,
      "z": 3
    },
    {
      "kind": "find",
      "id": "d_bed",
      "x": 29,
      "z": 18,
      "give": "card:hexmage",
      "text": "The moonflowers are open, and in the brightest bed, laid among the petals like a pressed leaf: a card. By day you'd never have seen it under the buds.",
      "text_fr": "Les belles-de-lune sont ouvertes, et dans le massif le plus lumineux, posée parmi les pétales comme une feuille séchée : une carte. Le jour, sous les boutons, vous ne l'auriez jamais vue.",
      "if": "time:night"
    },
    {
      "x": 15,
      "z": 24,
      "kind": "sign",
      "id": "skiff",
      "name": "A little skiff",
      "name_fr": "Un petit esquif",
      "dialogue": [
        {
          "lines": [
            "A skiff tied to a ring, oars shipped. A card in Nim's round hand: \"For Lumen's guests: back to the village. Push off, the current knows the way.\"",
            "The pool drains under the hedge into a channel, and the channel into the mere. A few strokes, and you bump against the lantern jetty."
          ],
          "lines_fr": [
            "Un esquif attaché à un anneau, les rames rentrées. Une carte de l'écriture ronde de Nim : « Pour les invités de Lumen : retour au village. Poussez, le courant connaît le chemin. »",
            "Le bassin s'écoule sous la haie dans un chenal, et le chenal dans le lac. Quelques coups de rame, et vous touchez le ponton aux lanternes."
          ],
          "do": [
            "warp:lanternmere:24:12:n"
          ]
        }
      ]
    },
    {
      "kind": "find",
      "id": "d_hedge_nook",
      "give": "coins:40",
      "text": "Tucked in the stump behind the hedge, where Nim keeps her pruning knife: the knife, and a twist of Facets for seeds.",
      "text_fr": "Dans la souche, derrière la haie, là où Nim range son sécateur : le sécateur, et un cornet de Facettes pour les graines.",
      "x": 34,
      "z": 7
    }
  ],
  "warps": [
    {
      "x": 19,
      "z": 15,
      "to": "moonwell_stair",
      "label": "Go down the well stair",
      "label_fr": "Descendre l'escalier du puits",
      "spawn": {
        "x": 3,
        "z": 3,
        "facing": "n"
      },
      "if": "item:kiln_lantern",
      "locked": "Steps spiral down inside the well, into a dark so thick the moonlight gives up at the third step. You'd want a light.",
      "locked_fr": "Des marches descendent en spirale dans le puits, dans un noir si épais que la lune renonce dès la troisième marche. Il vous faudrait une lumière."
    }
  ],
  "exits": [
    {
      "side": "n",
      "span": [
        18,
        20
      ],
      "to": "lanternmere"
    }
  ],
  "npcs": [
    {
      "id": "nim",
      "name": "Nim",
      "model": "npc_kid",
      "x": 25,
      "z": 15,
      "facing": "w",
      "idle": "Idle",
      "outfit": "#b9a6e0",
      "hair": "#3a2a20",
      "if": "!time:day",
      "dialogue": [
        {
          "if": "!flag:talked_nim",
          "lines": [
            "The moonflowers are open! This is the busy hour. Water, prune, whisper. In that order.",
            "I'm Nim. Lumen's apprentice. She's away in the Fernhollow shade, gathering seeds, so the garden is mine for now.",
            "She'll come home to keep the seal when the time comes. The well always knows before we do."
          ],
          "lines_fr": [
            "Les belles-de-lune sont ouvertes ! C'est l'heure de pointe. Arroser, tailler, chuchoter. Dans cet ordre.",
            "Moi, c'est Nim. L'apprentie de Lumen. Elle est partie à l'ombre de Creuse-Fougère ramasser des graines, alors le jardin est à moi, pour l'instant.",
            "Elle reviendra garder le sceau le moment venu. Le puits le sait toujours avant nous."
          ]
        },
        {
          "lines": [
            "Don't step on the beds. Do look in them. Things turn up in moonflowers.",
            "The well stair goes down to an old alcove. It's black as a closed eye in there. I never go without a light."
          ],
          "lines_fr": [
            "Ne marche pas sur les massifs. Mais regarde dedans. On trouve des choses dans les belles-de-lune.",
            "L'escalier du puits descend jusqu'à une vieille alcôve. Il fait noir comme un œil fermé, là-dedans. Je n'y vais jamais sans lumière."
          ]
        }
      ]
    },
    {
      "id": "t_maud",
      "name": "Maud",
      "model": "npc_wanderer",
      "x": 30,
      "z": 9,
      "facing": "s",
      "idle": "Idle",
      "trainer": {
        "sight": 3,
        "challenge": [
          "Hold still! There's a moth on your shoulder. A rare one. Oh, it's gone.",
          "You owe me a moth. Three prizes will do."
        ],
        "challenge_fr": [
          "Ne bouge pas ! Il y a une phalène sur ton épaule. Une rare. Oh, elle est partie.",
          "Tu me dois une phalène. Trois Récompenses feront l'affaire."
        ],
        "win": [
          "Flown off. Like the moth."
        ],
        "win_fr": [
          "Envolée. Comme la phalène."
        ],
        "lose": [
          "Netted! Come back when you're a little faster on the wing."
        ],
        "lose_fr": [
          "Dans le filet ! Reviens quand tu auras l'aile un peu plus rapide."
        ],
        "after": [
          "Ruben counts them, I catch them. We argue about which of us loves moths more. It's me."
        ],
        "after_fr": [
          "Ruben les compte, moi je les attrape. On se dispute pour savoir qui aime le plus les phalènes. C'est moi."
        ]
      },
      "outfit": "#5a4a8a",
      "hair": "#c8a070"
    },
    {
      "id": "t_noor",
      "name": "Noor",
      "model": "npc_scholar",
      "x": 8,
      "z": 14,
      "facing": "e",
      "idle": "Idle",
      "trainer": {
        "sight": 0,
        "challenge": [
          "Sit. Tell me what you dreamed last night. No? Then let the cards dream for you.",
          "Three prizes. I read the deck before I read the hand."
        ],
        "challenge_fr": [
          "Assieds-toi. Raconte-moi ton rêve de la nuit dernière. Non ? Alors laisse les cartes rêver pour toi.",
          "Trois Récompenses. Je lis le deck avant de lire la main."
        ],
        "win": [
          "I dreamed this. I just didn't dream who won."
        ],
        "win_fr": [
          "J'ai rêvé ça. Je n'avais simplement pas rêvé qui gagnait."
        ],
        "lose": [
          "Your deck dreams of water and wakes up dry. Rest, and try again."
        ],
        "lose_fr": [
          "Ton deck rêve d'eau et se réveille au sec. Repose-toi, et réessaie."
        ],
        "after": [
          "Lumen says the well dreams too. Of a seventh colour. I believe her on even nights."
        ],
        "after_fr": [
          "Lumen dit que le puits rêve aussi. D'une septième couleur. Je la crois les nuits paires."
        ]
      },
      "outfit": "#3a6a8a",
      "hair": "#1f1a2a"
    },
    {
      "id": "nim_day",
      "name": "Nim",
      "model": "npc_kid",
      "x": 9,
      "z": 23,
      "facing": "e",
      "idle": "Idle",
      "outfit": "#b9a6e0",
      "hair": "#3a2a20",
      "if": "time:day",
      "dialogue": [
        {
          "lines": [
            "Mm? Oh. Hello. Sorry. Garden hours are dusk to dawn. By day everything sleeps here, me included.",
            "Rest at the Quiet Lamp in Lanternmere, and come back when the moonflowers open. It's worth it."
          ],
          "lines_fr": [
            "Mm ? Oh. Bonjour. Pardon. Le jardin vit du crépuscule à l'aube. Le jour, tout dort ici, moi comprise.",
            "Repose-toi à la Lampe Tranquille, à Lac-aux-Lanternes, et reviens quand les belles-de-lune s'ouvrent. Ça vaut le coup."
          ]
        }
      ]
    }
  ],
