  "npcs": [
    {
      "id": "ansel",
      "name": "Ansel",
      "model": "npc_elder",
      "x": 19,
      "z": 14,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#6b6a4a",
      "hair": "#e6e2d8",
      "if": "!time:night",
      "dialogue": [
        {
          "if": "beat:t_hew",
          "lines": [
            "Beat our Hew? Good. He'd have been insufferable for a week.",
            "The flock likes you. Well, Biscuit does. Biscuit likes everyone."
          ],
          "lines_fr": [
            "Tu as battu notre Hew ? Tant mieux. Il aurait été insupportable pendant une semaine.",
            "Le troupeau t'aime bien. Enfin, Biscuit. Biscuit aime tout le monde."
          ]
        },
        {
          "lines": [
            "Morning! Mind the flock, they've opinions about strangers.",
            "Hew's my grandson. Duels everyone on the north lane. Gets that from his grandmother.",
            "When the wind comes off the sea, every chime post on the Downs hums at once. That's why they call them the Thrumming Downs."
          ],
          "lines_fr": [
            "Bonjour ! Attention au troupeau, ils ont un avis sur les étrangers.",
            "Hew, c'est mon petit-fils. Il défie tout le monde sur le chemin du nord. Ça lui vient de sa grand-mère.",
            "Quand le vent vient du large, tous les poteaux à carillons des Landes bourdonnent en même temps. C'est pour ça qu'on les appelle les Landes Vibrantes."
          ]
        }
      ]
    },
