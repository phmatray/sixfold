  "interactions": [
    {
      "x": 2,
      "z": 9,
      "kind": "sign",
      "text": "East along the coast road: Stormwatch. West: Cinderwick and the Emberlands.",
      "text_fr": "À l'est, par la route de la côte : Guette-Orage. À l'ouest : Mèche-Cendre et les Braisières."
    },
    {
      "x": 28,
      "z": 21,
      "kind": "sign",
      "text": "South: Stormwatch, on its bluff. North: the Downs.",
      "text_fr": "Sud : Guette-Orage, sur sa falaise. Nord : les Landes."
    },
    {
      "x": 6,
      "z": 17,
      "kind": "sign",
      "id": "chime_ring",
      "name": "The chime ring",
      "name_fr": "Le cercle des carillons",
      "dialogue": [
        {
          "if": "time:night",
          "lines": [
            "Six old posts round a standing stone. In the dark their chimes ring together, a low chord that hangs in the air."
          ],
          "lines_fr": [
            "Six vieux poteaux autour d'une pierre levée. Dans le noir, leurs carillons sonnent ensemble, un accord grave qui reste suspendu dans l'air."
          ],
          "do": [
            "sfx:chime"
          ]
        },
        {
          "lines": [
            "Six old posts round a standing stone. The chimes knock about in the wind, tuneless by day."
          ],
          "lines_fr": [
            "Six vieux poteaux autour d'une pierre levée. Les carillons s'entrechoquent dans le vent, sans mélodie le jour."
          ]
        }
      ]
    },
    {
      "kind": "find",
      "id": "st_wall",
      "x": 12,
      "z": 8,
      "give": "coins:50",
      "hidden": true,
      "text": "A loose stone at the end of the wall comes away in your hand. Behind it: Facets, wrapped in a shepherd's rag.",
      "text_fr": "Une pierre branlante au bout du mur vient toute seule. Derrière : des Facettes, roulées dans un chiffon de berger."
    },
    {
      "kind": "find",
      "id": "st_chimes",
      "x": 5,
      "z": 17,
      "give": "card:stormox",
      "text": "At night a hollow in the standing stone glows faintly blue. Inside, dry and humming: a card.",
      "text_fr": "La nuit, un creux de la pierre levée luit d'un bleu pâle. Dedans, sèche et bourdonnante : une carte.",
      "if": "time:night"
    },
    {
      "kind": "find",
      "id": "st_cliff",
      "x": 32,
      "z": 10,
      "give": "coins:40",
      "text": "Wedged in a crack on the cliff's lip, where the sea wind howls: a little purse of Facets.",
      "text_fr": "Coincée dans une fente au bord de la falaise, là où hurle le vent du large : une petite bourse de Facettes."
    }
  ],
