    {
      "id": "t_hew",
      "name": "Hew",
      "model": "npc_kid",
      "x": 4,
      "z": 7,
      "facing": "e",
      "idle": "Idle",
      "trainer": {
        "sight": 3,
        "challenge": [
          "Grandad says I'm not to duel strangers. You don't look strange. One prize!",
          "Meet Echopup: best sheepdog on the Downs. Well, card dog."
        ],
        "challenge_fr": [
          "Grand-père dit que je ne dois pas défier les étrangers. Tu n'as pas l'air étrange. Une Récompense !",
          "Je te présente Échouaf : le meilleur chien de berger des Landes. Enfin, chien de cartes."
        ],
        "win": [
          "Aw. Echopup says good game."
        ],
        "win_fr": [
          "Oh. Échouaf dit bien joué."
        ],
        "lose": [
          "Ha! Herded!"
        ],
        "lose_fr": [
          "Ha ! Rassemblé !"
        ],
        "after": [
          "Grandad's down by the fold with the flock. Don't tell him I lost."
        ],
        "after_fr": [
          "Grand-père est près de l'enclos avec le troupeau. Lui dis pas que j'ai perdu."
        ]
      },
      "outfit": "#4f7a4a",
      "hair": "#c8a46a"
    },
    {
      "id": "t_maren",
      "name": "Maren",
      "model": "npc_scholar",
      "x": 13,
      "z": 11,
      "facing": "n",
      "idle": "Idle",
      "trainer": {
        "sight": 4,
        "challenge": [
          "Gust from the north-west, force five. And a duellist, force... let's measure.",
          "Two prizes. Flashfin rides the wind."
        ],
        "challenge_fr": [
          "Rafale de nord-ouest, force cinq. Et un duelliste, force… mesurons.",
          "Deux Récompenses. Nagéclair surfe sur le vent."
        ],
        "win": [
          "Force six, then. Noted."
        ],
        "win_fr": [
          "Force six, alors. C'est noté."
        ],
        "lose": [
          "Calm conditions. Try again when you've got some wind in you."
        ],
        "lose_fr": [
          "Temps calme. Réessaie quand tu auras du vent dans les voiles."
        ],
        "after": [
          "The chime posts are my instruments. When they all hum, a storm's eight hours out."
        ],
        "after_fr": [
          "Les poteaux à carillons sont mes instruments. Quand ils bourdonnent tous, une tempête arrive dans huit heures."
        ]
      },
      "outfit": "#e2ad19",
      "hair": "#3a2a20"
    },
    {
      "id": "t_tull",
      "name": "Tull",
      "model": "npc_worker",
      "x": 28,
      "z": 7,
      "facing": "w",
      "idle": "Idle",
      "trainer": {
        "sight": 4,
        "challenge": [
          "Hear that post? Flat. Everything's flat today, including my mood. Duel?",
          "Two prizes. Ohmrunner keeps perfect time."
        ],
        "challenge_fr": [
          "Tu entends ce poteau ? Faux. Tout sonne faux aujourd'hui, même mon humeur. Un duel ?",
          "Deux Récompenses. Ohmcoureur garde le tempo parfait."
        ],
        "win": [
          "Ah. That rang true."
        ],
        "win_fr": [
          "Ah. Ça, ça sonnait juste."
        ],
        "lose": [
          "Off-key! Come back in tune."
        ],
        "lose_fr": [
          "Faux ! Reviens accordé."
        ],
        "after": [
          "There's a ring of old posts by the west wall. At night they play a chord nobody tuned. Not me, anyway."
        ],
        "after_fr": [
          "Il y a un cercle de vieux poteaux près du mur ouest. La nuit, ils jouent un accord que personne n'a accordé. Pas moi, en tout cas."
        ]
      },
      "outfit": "#8a6a3a",
      "hair": "#6a5a4a"
    },
    {
      "id": "t_odo",
      "name": "Odo",
      "model": "npc_wanderer",
      "x": 5,
      "z": 18,
      "facing": "e",
      "idle": "Idle",
      "trainer": {
        "sight": 3,
        "challenge": [
          "Out in the dark? Me too. I chase storms. Tonight I caught you.",
          "Three prizes, and Stormox charges like the sky."
        ],
        "challenge_fr": [
          "Dehors dans le noir ? Moi aussi. Je chasse les orages. Ce soir, c'est toi que j'ai attrapé.",
          "Trois Récompenses, et Taurorage charge comme le ciel."
        ],
        "win": [
          "Grounded. Spectacular."
        ],
        "win_fr": [
          "Mis à la terre. Spectaculaire."
        ],
        "lose": [
          "Struck! Ha!"
        ],
        "lose_fr": [
          "Foudroyé ! Ha !"
        ],
        "after": [
          "The stone in this ring glows at night. Something's hidden in it. I never looked: I'm always looking up."
        ],
        "after_fr": [
          "La pierre de ce cercle luit la nuit. Quelque chose y est caché. Je n'ai jamais regardé : je regarde toujours en l'air."
        ]
      },
      "outfit": "#2f3a5a",
      "hair": "#e2ad19",
      "if": "time:night"
    }
  ],
