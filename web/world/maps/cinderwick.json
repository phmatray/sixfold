  "npcs": [
    {
      "id": "marthe",
      "name": "Marthe",
      "model": "npc_elder",
      "x": 18,
      "z": 12,
      "facing": "w",
      "idle": "Idle",
      "outfit": "#7c4535",
      "hair": "#d8d0c8",
      "if": "!time:night",
      "dialogue": [
        {
          "lines": [
            "Forty years I've kept her lit. She hasn't gone out once, not even the winter of the long rain.",
            "Come back after dark if you want her story. Days are for stoking."
          ],
          "lines_fr": [
            "Quarante ans que je la garde allumée. Elle ne s'est jamais éteinte, pas même l'hiver de la grande pluie.",
            "Reviens après la tombée de la nuit si tu veux son histoire. Le jour, on attise."
          ]
        }
      ]
    },
    {
      "id": "marthe_night",
      "name": "Marthe",
      "model": "npc_elder",
      "x": 12,
      "z": 3,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#7c4535",
      "hair": "#d8d0c8",
      "if": "time:night",
      "dialogue": [
        {
          "lines": [
            "Look at her glow. The first kiln-folk built her round a coal they carried up from the Kilnmouth in a clay pot.",
            "Down in that crater there's a stone with six faces, one for each colour. And a top, smooth and blank.",
            "My grandmother said it was waiting for a seventh. Nobody knows what for. Kilns keep secrets better than people."
          ],
          "lines_fr": [
            "Regarde-la luire. Les premiers gens du four l'ont bâtie autour d'une braise montée de la Gueule-du-Four dans un pot de terre.",
            "Au fond de ce cratère, il y a une pierre à six faces, une par couleur. Et un dessus, lisse et vide.",
