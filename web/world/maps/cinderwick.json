  "interactions": [
    {
      "kind": "waymark",
      "id": "cinderwick",
      "x": 8,
      "z": 9
    },
    {
      "x": 29,
      "z": 9,
      "kind": "sign",
      "text": "East: the Thrumming Downs, and on to Stormwatch. West: Cinderwick plaza.",
      "text_fr": "Est : les Landes Vibrantes, puis Guette-Orage. Ouest : la place de Mèche-Cendre."
    },
    {
      "x": 16,
      "z": 24,
      "kind": "sign",
      "text": "North: Cinderwick. South: Emberstep Quarry, and the meadow beyond.",
      "text_fr": "Nord : Mèche-Cendre. Sud : la Carrière de Pas-de-Braise, et le pré au-delà."
    },
    {
      "x": 17,
      "z": 6,
      "kind": "sign",
      "text": "North, up through the cut: the Kilnmouth. Mind the heat.",
      "text_fr": "Au nord, par la tranchée : la Gueule-du-Four. Attention à la chaleur."
    },
    {
      "x": 21,
      "z": 16,
      "kind": "sign",
      "text": "The Bellows Inn. Soup, beds, and a fire that never goes out (it's the kiln's).",
      "text_fr": "Auberge du Soufflet. Soupe, lits, et un feu qui ne s'éteint jamais (c'est celui du four)."
    },
    {
      "x": 16,
      "z": 12,
      "kind": "sign",
      "id": "great_kiln",
      "name": "The Great Kiln",
      "name_fr": "Le Grand Four",
      "dialogue": [
        {
          "lines": [
            "Heat rolls out of the great mouth like a slow breath. Inside, behind the glow, racks of glass are turning orange.",
            "Above the arch someone has chiselled a hexagon, its six sides worn smooth by forty years of hands."
          ],
          "lines_fr": [
            "La chaleur sort de la grande gueule comme un souffle lent. Dedans, derrière la lueur, des rangées de verre virent à l'orange.",
            "Au-dessus de l'arche, quelqu'un a gravé un hexagone, ses six côtés polis par quarante ans de mains."
          ]
        }
      ]
    },
    {
      "x": 29,
      "z": 23,
      "kind": "sign",
      "id": "cullet_town",
      "name": "Glass by the rack",
      "name_fr": "Du verre près du séchoir",
      "glint": "flag:lantern_asked & !item:cullet_town & !flag:lantern_done",
      "dialogue": [
        {
          "if": "flag:lantern_done",
          "lines": [
            "Just a few chips of glass now."
          ],
          "lines_fr": [
            "Plus que quelques éclats de verre."
          ]
        },
        {
          "if": "item:cullet_town",
          "lines": [
            "Just a few chips of glass now."
          ],
          "lines_fr": [
            "Plus que quelques éclats de verre."
          ]
        },
        {
          "if": "flag:lantern_asked",
          "lines": [
            "Under the rack, among the chips, one shard of the old green, thick as a thumb.",
            "That's the kind Clio wants."
          ],
          "lines_fr": [
            "Sous le séchoir, parmi les éclats, un morceau de vieux vert, épais comme un pouce.",
            "C'est le genre que veut Clio."
          ],
          "do": [
            "give:cullet_town"
          ]
        },
        {
          "lines": [
            "Chips of coloured glass glitter under the rack. Pretty, and sharp."
          ],
          "lines_fr": [
            "Des éclats de verre coloré scintillent sous le séchoir. Jolis, et coupants."
          ]
        }
      ]
    },
    {
      "kind": "find",
      "id": "e_pond",
      "x": 16,
      "z": 18,
      "give": "coins:60",
      "text": "On the rock at the pond's rim, where the glassblowers sit to cool their hands: a little stack of Facets someone forgot.",
      "text_fr": "Sur le rocher au bord du bassin, là où les souffleurs viennent rafraîchir leurs mains : une petite pile de Facettes oubliée."
    },
    {
      "kind": "find",
      "id": "e_rack",
      "x": 1,
      "z": 8,
      "give": "give:curio_glass_marble",
      "hidden": true,
      "text": "Behind the bottles on the bottom shelf, wrapped in a rag: a glass marble the size of a plum, with a twist of ember inside.",
      "text_fr": "Derrière les bouteilles de l'étagère du bas, enveloppée dans un chiffon : une bille de verre grosse comme une prune, avec une volute de braise dedans."
    },
    {
      "kind": "find",
      "id": "e_catwalk",
      "x": 21,
      "z": 0,
      "give": "card:furnaceback",
      "text": "On the flue-watchers' perch, weighed down by a stone so the wind can't take it: a card, its edges a little scorched.",
      "text_fr": "Sur le perchoir des guetteurs de cheminée, coincée sous une pierre pour que le vent ne l'emporte pas : une carte, aux bords un peu roussis."
    }
  ],
