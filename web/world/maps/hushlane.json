  "npcs": [
    {
      "id": "t_iver",
      "name": "Iver",
      "model": "npc_scholar",
      "x": 18,
      "z": 8,
      "facing": "w",
      "idle": "Idle",
      "duelist": {
        "sight": 4,
        "challenge": [
          "Stop! Stay there. You've walked into a line. Of my poem. It's about willows.",
          "Rhymes with... no. Duel me while I think. Two prizes."
        ],
        "challenge_fr": [
          "Halte ! Ne bouge pas. Tu viens d'entrer dans un vers. De mon poème. Il parle des saules.",
          "Rime avec… non. Fais un duel pendant que je réfléchis. Deux cartes Récompense."
        ],
        "win": [
          "\"Defeated, I sat beneath the willow...\" Not bad. I'll keep that."
        ],
        "win_fr": [
          "« Vaincu, je m'assis sous le saule… » Pas mal. Je garde ça."
        ],
        "lose": [
          "Victory! It scans."
        ],
        "lose_fr": [
          "Victoire ! Ça sonne juste."
        ],
        "after": [
          "A willow is a tree that has decided to listen. I wrote that. Do you like it? Don't answer."
        ],
        "after_fr": [
          "Un saule est un arbre qui a décidé d'écouter. C'est de moi. Ça te plaît ? Ne réponds pas."
        ]
      },
      "outfit": "#5a6fb0",
      "hair": "#2b211c"
    },
    {
      "id": "ysolde",
      "name": "Ysolde",
      "model": "npc_gardener",
      "x": 16,
      "z": 15,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#8a6fb8",
      "hair": "#e8d8b0",
      "if": "!time:night",
      "dialogue": [
        {
          "lines": [
            "Willow wands. I soak them in the brook, then weave. Baskets, fences, a cradle once.",
            "The lane's quiet by day. Come back after dusk: the fireflies come up off the water, the moonflowers open, and Luce goes walking in her sleep.",
            "Don't wake her. Duel her, if you like. She plays better asleep."
          ],
          "lines_fr": [
            "Des baguettes de saule. Je les fais tremper dans le ruisseau, puis je tresse. Des paniers, des clôtures, un berceau, une fois.",
            "L'allée est calme le jour. Reviens après le crépuscule : les lucioles montent de l'eau, les belles-de-lune s'ouvrent, et Luce se promène en dormant.",
            "Ne la réveille pas. Fais-lui un duel, si tu veux. Elle joue mieux endormie."
          ]
        }
      ]
    },
    {
      "id": "t_luce",
      "name": "Luce",
      "model": "npc_kid",
      "x": 16,
      "z": 24,
      "facing": "e",
      "idle": "Idle",
      "duelist": {
        "sight": 2,
        "challenge": [
          "Mm... is it my turn? It's always my turn in the dream.",
          "One prize. Don't wake me up..."
        ],
        "challenge_fr": [
          "Mm… c'est à moi ? C'est toujours à moi, dans le rêve.",
          "Une carte Récompense. Ne me réveille pas…"
        ],
        "win": [
          "Mm. I dreamed I lost. Oh. I did."
        ],
        "win_fr": [
          "Mm. J'ai rêvé que je perdais. Oh. C'est vrai."
        ],
        "lose": [
          "Zzz... I win... zzz..."
        ],
        "lose_fr": [
          "Zzz… j'ai gagné… zzz…"
        ],
        "after": [
          "I walk the same loop every night. I wake up in my bed with grass on my feet."
        ],
        "after_fr": [
          "Je fais la même boucle toutes les nuits. Je me réveille dans mon lit avec de l'herbe sous les pieds."
        ]
