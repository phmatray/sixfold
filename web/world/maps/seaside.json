  "npcs": [
    {
      "idle": "Idle",
      "id": "t_pell",
      "name": "Pell",
      "model": "npc_sailor",
      "tint": "#4a78b8",
      "outfit": "#2f5f8a",
      "hair": "#6b4a2e",
      "x": 16,
      "z": 8,
      "facing": "s",
      "duelist": {
        "sight": 3,
        "challenge": [
          "Shh, you'll scare the... oh. Nothing was biting anyway.",
          "Did I tell you about the fish? This long. There's a Streamfin in my deck in its honour. Duel?"
        ],
        "challenge_fr": [
          "Chut, tu vas faire fuir le… ah. De toute façon, rien ne mordait.",
          "Je t'ai parlé du poisson ? Long comme ça. J'ai mis un Nageflot dans mon deck en son honneur. Un duel ?"
        ],
        "win": [
          "Slipped off the hook. Like the fish.",
          "Here's your purse. Don't tell the gulls."
        ],
        "win_fr": [
          "Décroché. Comme le poisson.",
          "Voilà ta bourse. Ne le dis pas aux mouettes."
        ],
        "lose": [
          "Reeled in! Patience, that's the secret.",
          "Patience and bait. Mostly bait."
        ],
        "lose_fr": [
          "Ferré ! La patience, c'est tout le secret.",
          "La patience et l'appât. Surtout l'appât."
        ],
        "after": [
          "It was this long. No, this long. Ask anyone. Well, nobody saw it."
        ],
        "after_fr": [
          "Il était long comme ça. Non, comme ça. Demande à n'importe qui. Enfin, personne ne l'a vu."
        ]
      }
    },
    {
      "idle": "Idle",
      "id": "t_nell",
      "name": "Nell",
      "model": "npc_worker",
      "tint": "#e05a48",
      "outfit": "#d6402f",
      "hair": "#3a2a20",
      "x": 24,
      "z": 4,
      "facing": "s",
      "duelist": {
        "sight": 3,
        "challenge": [
          "*Fweet!* No running on the pier!",
          "Marlo's gone back to the Bellflats, and my Kelpwardens are still in the way. Rules are rules."
        ],
        "challenge_fr": [
          "*Tuiiit !* On ne court pas sur la jetée !",
          "Marlo est reparti aux Grèves de la Cloche, et mes Gardevarech sont toujours sur le chemin. Le règlement, c'est le règlement."
        ],
        "win": [
          "*Fweet.* Clean win. I'd have blown for anything less.",
          "Here's your purse. Walk, don't run."
        ],
        "win_fr": [
          "*Tuiiit.* Victoire propre. J'aurais sifflé pour moins que ça.",
          "Voilà ta bourse. On marche, on ne court pas."
        ],
        "lose": [
          "*Fweet! Fweet!* Misplay! You left your Active out to dry.",
          "Back to the beach, and warm up properly this time."
        ],
        "lose_fr": [
          "*Tuiiit ! Tuiiit !* Faute ! Tu as laissé ton Hexon Actif sécher au soleil.",
          "Retour à la plage, et échauffe-toi correctement cette fois."
        ],
        "after": [
          "Marlo's out at the Bellflats now. Walking pace, please. The planks are wet."
        ],
        "after_fr": [
          "Marlo est aux Grèves de la Cloche, maintenant. Au pas, s'il te plaît. Les planches sont mouillées."
        ]
      }
    },
    {
      "id": "dace",
      "name": "Dace",
      "model": "npc_kid",
      "tint": "#8fd0ff",
      "scale": 0.82,
      "x": 26,
      "z": 7,
      "facing": "w",
      "dialogue": [
        {
          "if": "item:kite_line",
          "do": [
            "take:kite_line",
            "pack:storm",
            "flag:kite_done",
            "emote:dace:heart"
          ],
          "lines": [
            "The line! Skye's line! Hold this end. Pull. Gently... GENTLY...",
            "It's free! Look at it go!",
            "Here. Mum says I have to give you something, so: a pack. It's a Storm one. Kite weather."
          ],
          "lines_fr": [
            "La ligne ! La ligne de Skye ! Tiens ce bout. Tire. Doucement… DOUCEMENT…",
            "Il est libre ! Regarde-le filer !",
            "Tiens. Maman dit que je dois te donner quelque chose, alors : un booster. Un Orage. Un temps à cerf-volant."
          ]
        },
        {
          "if": "!flag:kite_asked",
          "do": [
            "flag:kite_asked"
          ],
          "lines": [
            "See that red tail, up on the lighthouse rail? That's my kite. Skye made it for me.",
            "The wind took it. Now it's stuck, and I can't reach, and Ottilie says the rail is \"not for children\".",
            "Skye's got line, loads of it. But Skye won't hand anything over until you've duelled her. That's just Skye."
          ],
          "lines_fr": [
            "Tu vois la queue rouge, là-haut, sur la rambarde du phare ? C'est mon cerf-volant. C'est Skye qui me l'a fait.",
            "Le vent l'a emporté. Maintenant il est coincé, je n'arrive pas à l'attraper, et Ottilie dit que la rambarde, « ce n'est pas pour les enfants ».",
            "Skye a de la ligne, des tonnes. Mais elle ne donne rien tant qu'on ne l'a pas affrontée en duel. Skye, c'est comme ça."
          ]
        },
        {
          "if": "!flag:kite_done",
          "lines": [
            "Still stuck. Skye's the one with the line, by the boats east of the pier."
          ],
          "lines_fr": [
            "Toujours coincé. C'est Skye qui a la ligne, près des barques, à l'est de la jetée."
          ]
        },
        {
          "if": "beat:warden",
          "lines": [
            "Marlo says the new champion fishes better than me.",
            "Marlo's never even seen you fish. Marlo's still right."
          ],
          "lines_fr": [
            "D'après Marlo, la nouvelle star du coin pêche mieux que moi.",
            "Marlo ne sait même pas si tu pêches. Marlo a quand même raison."
          ]
        },
        {
          "if": "beat:marlo",
          "lines": [
            "You beat Marlo? Marlo doesn't lose. Marlo told me Marlo doesn't lose."
          ],
          "lines_fr": [
            "T'as battu Marlo ? Marlo ne perd pas. Marlo m'a dit que Marlo ne perdait pas."
          ]
        },
        {
          "if": "flag:kite_done",
          "lines": [
            "It flies every day now. I tie it to the pier. Twice."
          ],
          "lines_fr": [
            "Il vole tous les jours, maintenant. Je l'attache à la jetée. Deux fois."
          ]
        },
        {
          "lines": [
            "Nothing's biting. I think the fish are duelling too.",
            "Marlo's gone back out to the Bellflats, by the seal stone. Bring a good deck, the tide's on Marlo's side."
          ],
          "lines_fr": [
            "Ça ne mord pas. Je crois que les poissons font des duels, eux aussi.",
            "Marlo est reparti aux Grèves de la Cloche, près de la pierre de sceau. Prends un bon deck, la marée est du côté de Marlo."
          ]
        }
      ],
      "idle": "Idle"
    },
    {
      "idle": "Idle",
      "id": "t_skye",
      "name": "Skye",
      "model": "npc_kid",
      "tint": "#7cc4ff",
      "outfit": "#4aa3e8",
      "hair": "#f2d16b",
      "scale": 0.9,
      "x": 31,
      "z": 9,
      "facing": "s",
      "duelist": {
        "sight": 4,
        "challenge": [
          "Wind's from the west, gusting four. Perfect duelling weather.",
          "I read the wind; my Stormox reads the rest. Shall we?"
        ],
        "challenge_fr": [
          "Vent d'ouest, rafales force quatre. Un temps parfait pour un duel.",
          "Moi, je lis le vent ; mon Taurorage lit le reste. On y va ?"
        ],
        "win": [
          "The wind turned on me. It does that.",
          "Here. A purse for somebody who reads the gusts better than I do."
        ],
        "win_fr": [
          "Le vent a tourné. Ça lui arrive.",
          "Tiens. Une bourse, pour quelqu'un qui lit les rafales mieux que moi."
        ],
        "lose": [
          "Caught you in a crosswind. Happens to the best.",
          "Come back when the wind's on your side."
        ],
        "lose_fr": [
          "Pris dans un vent de travers. Ça arrive aux meilleurs.",
          "Reviens quand le vent sera de ton côté."
        ],
        "after": [
          "See the red tail on the lighthouse rail? I built that kite. Dace flew it. The wind kept it."
        ],
        "after_fr": [
          "Tu vois la queue rouge, sur la rambarde du phare ? Ce cerf-volant, c'est moi qui l'ai fabriqué. Dace l'a fait voler. Le vent l'a gardé."
        ]
      },
      "dialogue": [
        {
          "if": "beat:t_skye & flag:kite_asked & !flag:kite_line_given",
          "do": [
            "give:kite_line",
            "flag:kite_line_given"
          ],
          "lines": [
            "Dace sent you? Of course Dace sent you.",
            "Here, my spare reel. Waxed line, long enough to reach the lamp room. Tie it to the tail and tug gently. Gently!"
          ],
          "lines_fr": [
            "C'est Dace qui t'envoie ? Évidemment, c'est Dace.",
            "Tiens, ma bobine de secours. Une ligne cirée, assez longue pour atteindre la lanterne. Noue-la à la queue et tire doucement. Doucement !"
          ]
        }
      ]
    },
    {
      "id": "ottilie",
      "name": "Ottilie",
      "model": "npc_gardener",
      "tint": "#f2c48d",
      "scale": 1,
      "x": 48,
      "z": 4,
      "facing": "s",
      "dialogue": [
        {
          "if": "beat:warden&flag:letter_delivered",
          "lines": [
            "I saw the hall's lamps burning all night from up here. Hob says that was you.",
            "A champion carried my letter. I'll tell the gulls."
          ],
          "lines_fr": [
