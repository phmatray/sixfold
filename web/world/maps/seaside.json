  "npcs": [
    {
      "id": "marlo",
      "name": "Marlo",
      "model": "rival_water",
      "tint": "#73b8f2",
      "scale": 1.0,
      "idle": "Idle",
      "x": 15,
      "z": 1,
      "facing": "s",
      "dialogue": [
        {
          "if": "won:marlo",
          "lines": [
            "Washed out, fair and square.",
            "Take my seal, it's still a little damp."
          ]
        },
        {
          "if": "lost:marlo",
          "lines": [
            "Low tide for you today. The water always comes back in."
          ]
        },
        {
          "if": "beat:marlo",
          "lines": [
            "The tide's turned. Another round?"
          ],
          "do": [
            "duel:marlo"
          ]
        },
        {
          "lines": [
            "Shh. Listen... that's the sea. Or a kettle. Hard to tell out here.",
            "I'm Marlo. I read the tide tables, and whoever sits down across from me.",
            "Three prizes. Pull up a crate, the cards are already dealt."
          ],
          "do": [
            "duel:marlo"
          ]
        }
      ]
    },
    {
      "id": "quill",
      "name": "Quill",
      "model": "rival_lightning",
      "tint": "#ffd84d",
      "scale": 1.0,
      "idle": "Idle",
      "x": 24,
      "z": 6,
      "facing": "s",
      "dialogue": [
        {
          "if": "won:quill",
          "lines": [
            "Well. I'll be recording that one as a downpour.",
            "My seal is yours. Mark it in your own notebook."
          ]
        },
        {
          "if": "lost:quill",
          "lines": [
            "Clear skies for me today. Check the forecast and come back."
          ]
        },
        {
          "if": "!open:quill",
          "lines": [
            "Hold on. You carry fewer than three seals.",
            "I only write up duels worth reading. Come back with three."
          ]
        },
        {
          "if": "beat:quill",
          "lines": [
            "New page, same storm. Ready?"
          ],
          "do": [
            "duel:quill"
          ]
        },
        {
          "lines": [
            "Clouds are stacking up over the sea. Good dueling weather.",
            "I'm Quill. I note the wind, the rain and every duel I play.",
            "Four prizes, and I'll be writing it all down."
          ],
          "do": [
            "duel:quill"
          ]
        }
      ]
    },
    {
      "id": "ottilie",
      "name": "Ottilie",
      "model": "npc_gardener",
      "tint": "#f2c48d",
      "scale": 1.0,
      "x": 27,
      "z": 5,
      "facing": "w",
      "dialogue": [
        {
          "if": "flag:letter_delivered",
          "lines": [
            "Hob wrote back already? He never writes back. You must have charmed him.",
            "Come by at dusk some time. The lamp is worth the climb."
          ]
        },
        {
          "if": "item:letter",
          "lines": [
            "The letter goes to Hob, at the bakery in Brightwell Square.",
            "South of the meadow. Follow your nose, it smells of bread."
          ]
        },
        {
          "lines": [
            "Mind the steps, they're slippery with spray. I keep the lamp here.",
            "Are you walking inland? Would you take this to my brother Hob? He bakes in Brightwell Square.",
            "Don't let it get wet. That's the whole trick of letters."
          ],
          "do": [
            "give:letter"
          ]
        }
      ],
      "idle": "Idle"
    },
    {
      "id": "dace",
      "name": "Dace",
      "model": "npc_kid",
      "tint": "#8fd0ff",
      "scale": 0.82,
      "x": 15,
      "z": 4,
      "facing": "e",
      "dialogue": [
        {
          "if": "beat:marlo",
          "lines": [
            "You beat Marlo? Marlo doesn't lose. Marlo told me Marlo doesn't lose."
          ]
        },
        {
          "lines": [
            "Nothing's biting. I think the fish are dueling too.",
            "Marlo sits at the end of the pier. Bring a good deck, the tide's on Marlo's side."
          ]
        }
      ],
      "idle": "Idle"
    }
  ],
