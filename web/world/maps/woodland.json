  "npcs": [
    {
      "id": "bramble",
      "name": "Bramble",
      "model": "rival_grass",
      "tint": "#8fd17a",
      "scale": 1.0,
      "idle": "Idle",
      "x": 10,
      "z": 10,
      "facing": "s",
      "dialogue": [
        {
          "if": "won:bramble&flag:thanked_bramble",
          "lines": [
            "Pruned again! Green thumbs and sharp cards, that's you."
          ],
          "lines_fr": [
            "Encore élagué ! La main verte et des cartes affûtées, c'est bien toi."
          ]
        },
        {
          "if": "won:bramble",
          "lines": [
            "Well! You pruned me right back.",
            "Take my seal. Five more rivals carry one each.",
            "And a Thistlewick for your binder. It only pricks a little."
          ],
          "lines_fr": [
            "Eh bien ! Tu m'as taillé à ras.",
            "Prends mon sceau. Cinq autres rivaux en ont chacun un.",
            "Et un Chardomèche pour ton classeur. Il ne pique qu'un peu."
          ],
          "do": [
            "flag:thanked_bramble"
          ]
        },
        {
          "if": "lost:bramble",
          "lines": [
            "Ha, tangled up! Happens to everyone the first time.",
            "Catch your breath and come try again."
          ],
          "lines_fr": [
            "Ha, pris dans les ronces ! Ça arrive à tout le monde, la première fois.",
            "Reprends ton souffle et reviens tenter ta chance."
          ]
        },
        {
          "if": "beat:warden",
          "lines": [
            "Champion! The hedges stood up straighter when they heard.",
            "Fancy a trim? Two prizes, as always."
          ],
          "lines_fr": [
            "Champion ! Les haies se sont redressées en apprenant la nouvelle.",
            "Une petite taille ? Deux Récompenses, comme toujours."
          ],
          "do": [
            "duel:bramble"
          ]
        },
        {
          "if": "beat:bramble",
          "lines": [
            "Back for more thorns? Two prizes, same as before."
          ],
          "lines_fr": [
            "Tu reviens chercher des épines ? Deux Récompenses, comme la dernière fois."
          ],
          "do": [
            "duel:bramble"
          ]
        },
        {
          "lines": [
            "Mind the hedge, it bites. Only a little.",
            "I'm Bramble. I keep the hedges along this trail tidy, and I keep a deck for visitors.",
            "A short one, two prizes. Shall we?"
          ],
          "lines_fr": [
            "Attention à la haie, elle mord. Juste un peu.",
            "Moi, c'est Bramble. J'entretiens les haies du sentier, et je garde un deck pour les visiteurs.",
            "Un duel court, deux Récompenses. On y va ?"
          ],
          "do": [
            "duel:bramble"
          ]
        }
      ]
    },
    {
      "id": "lumen",
      "name": "Lumen",
      "model": "rival_psychic",
      "tint": "#ba8ce9",
      "scale": 1.0,
      "idle": "Idle",
      "x": 5,
      "z": 3,
      "facing": "s",
      "dialogue": [
        {
          "if": "won:lumen&flag:thanked_lumen",
          "lines": [
            "Wide awake again. I'll have to brew something stronger."
          ],
          "lines_fr": [
            "Toujours les yeux grands ouverts. Il me faudra une infusion plus forte."
          ]
        },
        {
          "if": "won:lumen",
          "lines": [
            "You stayed awake the whole time. Impressive.",
            "My seal. With six, the sealed door in the duel hall is yours.",
            "And Moonmoth. It sings, but only at night."
          ],
          "lines_fr": [
            "Tu n'as pas fermé l'œil de tout le duel. Impressionnant.",
            "Mon sceau. Avec six, la porte scellée de la salle des duels est à toi.",
            "Et Phalune. Elle chante, mais seulement la nuit."
          ],
          "do": [
            "flag:thanked_lumen"
          ]
        },
        {
          "if": "lost:lumen",
          "lines": [
            "Sweet dreams. Wake up and try again."
          ],
          "lines_fr": [
            "Fais de beaux rêves. Puis réveille-toi et réessaie."
          ]
        },
        {
          "if": "!open:lumen",
          "lines": [
            "You look tired. Five seals first, then we'll talk.",
            "Rest up: the others are still waiting."
          ],
          "lines_fr": [
            "Tu as une petite mine. Cinq sceaux d'abord, on en reparlera.",
            "Repose-toi : les autres t'attendent encore."
          ]
        },
        {
          "if": "beat:warden",
          "lines": [
            "You beat Sable and you're still not yawning. Remarkable.",
            "The moon's up. One more? Six prizes."
          ],
          "lines_fr": [
            "Tu as battu Sable et tu ne bâilles toujours pas. Remarquable.",
            "La lune est levée. Encore un ? Six Récompenses."
          ],
          "do": [
            "duel:lumen"
          ]
        },
        {
          "if": "beat:lumen",
          "lines": [
            "The moon's up again. Shall we?"
          ],
          "lines_fr": [
            "La lune s'est encore levée. On y va ?"
          ],
          "do": [
            "duel:lumen"
          ]
        },
        {
          "lines": [
            "You found the shade. Good. My garden only grows at night.",
            "I'm Lumen. Six prizes, and I don't let anyone sleep through them."
          ],
          "lines_fr": [
            "Tu as trouvé l'ombre. Bien. Mon jardin ne pousse que la nuit.",
            "Je suis Lumen. Six Récompenses, et personne ne s'endort pendant mes duels."
          ],
          "do": [
            "duel:lumen"
          ]
        }
      ]
    },
    {
      "id": "fennel",
      "name": "Fennel",
      "model": "npc_wanderer",
      "tint": "#a3d9a5",
      "scale": 0.96,
      "x": 19,
      "z": 4,
      "facing": "w",
      "dialogue": [
        {
          "if": "beat:warden&flag:lens_returned",
          "lines": [
            "I saw a champion through my lens today! ...Oh, it was you. It still counts."
          ],
          "lines_fr": [
            "J'ai repéré un champion à la longue-vue aujourd'hui ! …Ah, c'était toi. Ça compte quand même."
          ]
        },
        {
          "if": "flag:lens_returned",
          "lines": [
            "A grey heron! Right there! ...You missed it. It's fine, there'll be another.",
            "Thanks again for the lens. Everything is so close now."
          ],
          "lines_fr": [
            "Un héron cendré ! Juste là ! …Tu l'as raté. C'est rien, il en passera un autre.",
            "Merci encore pour la longue-vue. Tout est si proche, maintenant."
          ]
        },
        {
          "if": "item:field_lens",
          "lines": [
            "Is that my field lens? Scratched cap, brass ring... it is!",
            "You found it up at the quarry? I must have set it down watching the falcons.",
            "Please, take this pack. I'd only lose it too."
          ],
          "lines_fr": [
            "C'est ma longue-vue ? Capuchon rayé, bague en laiton… c'est elle !",
            "Tu l'as trouvée à la carrière ? J'ai dû la poser en regardant les faucons.",
            "Tiens, prends ce booster. Je finirais par le perdre aussi."
          ],
          "do": [
            "flag:lens_returned",
            "pack:grove"
          ]
        },
        {
          "if": "flag:talked_fennel",
          "lines": [
            "Still no lens. The last place I had it was the high ledge in Emberstep Quarry.",
            "Up the steps past Orla, and up again. Watch the edges."
          ],
          "lines_fr": [
            "Toujours pas de longue-vue. Je l'avais encore sur la haute corniche de la Carrière de Pas-de-Braise.",
            "Monte les marches après Orla, puis monte encore. Attention au bord."
          ]
        },
        {
          "lines": [
            "Shh... no, it's gone. A kingfisher, I think. Without my field lens it's all just blurs.",
            "I lost it somewhere up at Emberstep Quarry, north of the meadow, watching the falcons on the high ledge.",
            "If you're passing that way, keep an eye out? It glints."
          ],
          "lines_fr": [
            "Chut… non, envolé. Un martin-pêcheur, je crois. Sans ma longue-vue, tout est flou.",
            "Je l'ai perdue à la Carrière de Pas-de-Braise, au nord du pré, en guettant les faucons sur la haute corniche.",
            "Si tu passes par là, tu ouvres l'œil ? Elle brille."
          ]
        }
      ],
      "idle": "Idle"
    }
  ],
