  "npcs": [
    {
      "id": "bramble",
      "name": "Bramble",
      "model": "rival_grass",
      "tint": "#8fd17a",
      "scale": 1.0,
      "idle": "Idle",
      "x": 10,
      "z": 10,
      "facing": "s",
      "dialogue": [
        {
          "if": "won:bramble&flag:thanked_bramble",
          "lines": [
            "Pruned again! Green thumbs and sharp cards, that's you."
          ]
        },
        {
          "if": "won:bramble",
          "lines": [
            "Well! You pruned me right back.",
            "Take my seal. Five more rivals carry one each.",
            "And a Thistlewick for your binder. It only pricks a little."
          ],
          "do": [
            "flag:thanked_bramble"
          ]
        },
        {
          "if": "lost:bramble",
          "lines": [
            "Ha, tangled up! Happens to everyone the first time.",
            "Catch your breath and come try again."
          ]
        },
        {
          "if": "beat:warden",
          "lines": [
            "Champion! The hedges stood up straighter when they heard.",
            "Fancy a trim? Two prizes, as always."
          ],
          "do": [
            "duel:bramble"
          ]
        },
        {
          "if": "beat:bramble",
          "lines": [
            "Back for more thorns? Two prizes, same as before."
          ],
          "do": [
            "duel:bramble"
          ]
        },
        {
          "lines": [
            "Mind the hedge, it bites. Only a little.",
            "I'm Bramble. I keep the hedges along this trail tidy, and I keep a deck for visitors.",
            "A short one, two prizes. Shall we?"
          ],
          "do": [
            "duel:bramble"
          ]
        }
      ]
    },
    {
      "id": "lumen",
      "name": "Lumen",
      "model": "rival_psychic",
      "tint": "#ba8ce9",
      "scale": 1.0,
      "idle": "Idle",
      "x": 5,
      "z": 3,
      "facing": "s",
      "dialogue": [
        {
          "if": "won:lumen&flag:thanked_lumen",
          "lines": [
            "Wide awake again. I'll have to brew something stronger."
          ]
        },
        {
          "if": "won:lumen",
          "lines": [
            "You stayed awake the whole time. Impressive.",
            "My seal. With six, the sealed door in the duel hall is yours.",
            "And Moonmoth. It sings, but only at night."
          ],
          "do": [
            "flag:thanked_lumen"
          ]
        },
        {
          "if": "lost:lumen",
          "lines": [
            "Sweet dreams. Wake up and try again."
          ]
        },
        {
          "if": "!open:lumen",
          "lines": [
            "You look tired. Five seals first, then we'll talk.",
            "Rest up: the others are still waiting."
          ]
        },
        {
          "if": "beat:warden",
          "lines": [
            "You beat Sable and you're still not yawning. Remarkable.",
            "The moon's up. One more? Six prizes."
          ],
          "do": [
            "duel:lumen"
          ]
        },
        {
          "if": "beat:lumen",
          "lines": [
            "The moon's up again. Shall we?"
          ],
          "do": [
            "duel:lumen"
          ]
        },
        {
          "lines": [
            "You found the shade. Good. My garden only grows at night.",
            "I'm Lumen. Six prizes, and I don't let anyone sleep through them."
          ],
          "do": [
            "duel:lumen"
          ]
        }
      ]
    },
    {
      "id": "fennel",
      "name": "Fennel",
      "model": "npc_wanderer",
      "tint": "#a3d9a5",
      "scale": 0.96,
      "x": 19,
      "z": 4,
      "facing": "w",
      "dialogue": [
        {
          "if": "beat:warden&flag:lens_returned",
          "lines": [
            "I saw a champion through my lens today! ...Oh, it was you. It still counts."
          ]
        },
        {
          "if": "flag:lens_returned",
          "lines": [
            "A grey heron! Right there! ...You missed it. It's fine, there'll be another.",
            "Thanks again for the lens. Everything is so close now."
          ]
        },
        {
          "if": "item:field_lens",
          "lines": [
            "Is that my field lens? Scratched cap, brass ring... it is!",
            "You found it up at the quarry? I must have set it down watching the falcons.",
            "Please, take this pack. I'd only lose it too."
          ],
          "do": [
            "flag:lens_returned",
            "pack:grove"
          ]
        },
        {
          "if": "flag:talked_fennel",
          "lines": [
            "Still no lens. The last place I had it was the high ledge in Emberstep Quarry.",
            "Up the steps past Orla, and up again. Watch the edges."
          ]
        },
        {
          "lines": [
            "Shh... no, it's gone. A kingfisher, I think. Without my field lens it's all just blurs.",
            "I lost it somewhere up at Emberstep Quarry, north of the meadow, watching the falcons on the high ledge.",
            "If you're passing that way, keep an eye out? It glints."
          ]
        }
      ],
      "idle": "Idle"
    }
  ],
