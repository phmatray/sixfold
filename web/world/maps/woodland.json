  "interactions": [
    {"x": 24, "z": 11, "kind": "sign", "text": "Fernhollow Trail. East: back to Sixfold Meadow. Over the bridge and north: the moonflower glade.", "text_fr": "Sentier de Creuse-Fougère. Est : retour au Pré de Sixfold. Après le pont, au nord : la clairière des fleurs de lune."},
    {"x": 21, "z": 6, "kind": "sign", "text": "Lookout. Herons nest by the stream in spring. Quiet feet, please.", "text_fr": "Belvédère. Les hérons nichent près du ruisseau au printemps. Marchez sans bruit, s'il vous plaît."}
