  "npcs": [
    {
      "id": "edda",
      "name": "Edda",
      "model": "npc_elder",
      "x": 12,
      "z": 21,
      "facing": "n",
      "idle": "Idle",
      "outfit": "#5a3e36",
      "hair": "#e8e0d6",
      "dialogue": [
        {
          "if": "!time:day & !time:dawn",
          "lines": [
            "Hear that? Nothing. The vents are asleep. Go on: the high terrace is yours till dawn.",
            "Vela's up on the north rim, if you're looking for trouble. She usually is."
          ],
          "lines_fr": [
            "Tu entends ? Rien. Les évents dorment. Vas-y : la haute terrasse est à toi jusqu'à l'aube.",
            "Vela est sur le rebord nord, si tu cherches les ennuis. Elle, elle les cherche toujours."
          ]
        },
        {
          "lines": [
            "Mind the vents on the high terrace. By day they'd boil an egg in your pocket.",
            "After dark the rock cools and they drop to a whisper. Then you can walk the high terrace all the way round, under the north rim.",
            "I've read these vents for fifty years. They're like people: hot-headed by day, quiet at night."
          ],
          "lines_fr": [
            "Attention aux évents de la haute terrasse. Le jour, ils te cuiraient un œuf dans la poche.",
            "Après la tombée de la nuit, la roche refroidit et ils ne font plus qu'un murmure. Alors tu peux faire tout le tour, sous le rebord nord.",
            "Je lis ces évents depuis cinquante ans. Ils sont comme les gens : soupe au lait le jour, calmes la nuit."
          ]
        }
      ]
    },
    {
      "id": "t_carys",
      "name": "Carys",
      "model": "npc_wanderer",
      "x": 11,
      "z": 15,
      "facing": "e",
      "idle": "Idle",
      "trainer": {
        "sight": 3,
        "challenge": [
          "You came down the spiral? Then you can take some heat.",
          "Three prizes. My Blazelynx don't blink."
        ],
        "challenge_fr": [
          "Tu es descendu par la spirale ? Alors tu supportes la chaleur.",
          "Trois Récompenses. Mes Brasilynx ne clignent pas des yeux."
        ],
        "win": [
          "Burnt my soles. Well walked."
        ],
        "win_fr": [
          "Je me suis brûlé la plante des pieds. Bien marché."
        ],
        "lose": [
          "Keep your feet moving next time."
        ],
        "lose_fr": [
          "La prochaine fois, garde les pieds en mouvement."
        ],
        "after": [
          "I walk the hot floor barefoot every morning. Builds character. And blisters."
        ],
        "after_fr": [
          "Je marche pieds nus sur le fond brûlant tous les matins. Ça forge le caractère. Et les ampoules."
        ]
      },
      "outfit": "#e1572f",
      "hair": "#2b211c"
    },
    {
      "id": "t_dunstan",
      "name": "Dunstan",
      "model": "npc_worker",
      "x": 18,
      "z": 11,
      "facing": "w",
      "idle": "Idle",
      "trainer": {
        "sight": 3,
        "challenge": [
          "Every speck of this ash was a kiln once. I sift it for what's left.",
          "Two prizes. My Ash Sifters bring back what burns away."
        ],
        "challenge_fr": [
          "Chaque grain de cette cendre a été un four, autrefois. Je la tamise pour ce qui reste.",
          "Deux Récompenses. Mes Tamis à cendres rapportent ce qui a brûlé."
        ],
        "win": [
          "Swept clean."
        ],
        "win_fr": [
          "Balayé."
        ],
        "lose": [
          "Nothing's wasted. Not even you."
        ],
        "lose_fr": [
          "Rien ne se perd. Pas même toi."
        ],
        "after": [
          "Found a glass bead this morning. Third this year. Good year."
        ],
        "after_fr": [
          "J'ai trouvé une perle de verre ce matin. La troisième de l'année. Bonne année."
        ]
      },
      "outfit": "#7a6a5a",
      "hair": "#5a4a3a"
    },
    {
      "id": "t_vela",
      "name": "Vela",
      "model": "npc_rival",
      "x": 20,
      "z": 1,
      "facing": "w",
      "idle": "Idle",
      "trainer": {
        "sight": 5,
        "challenge": [
          "You're on my rim at night. Nobody's on my rim at night.",
          "Three prizes, and I don't go easy. The kiln never does."
        ],
        "challenge_fr": [
          "Tu es sur mon rebord, la nuit. Personne ne vient sur mon rebord la nuit.",
          "Trois Récompenses, et je ne fais pas de cadeau. Le four non plus."
        ],
        "win": [
          "...Fine. You can stand here. Quietly."
        ],
        "win_fr": [
          "… Bon. Tu peux rester. En silence."
        ],
        "lose": [
          "Back down the spiral. Mind the vents: they wake at dawn."
        ],
        "lose_fr": [
          "Redescends la spirale. Attention aux évents : ils se réveillent à l'aube."
        ],
        "after": [
          "From up here you can see Cinderwick glow. Forty years of Marthe. I'm next, she says."
        ],
        "after_fr": [
          "D'ici, on voit luire Mèche-Cendre. Quarante ans de Marthe. La suivante, ce sera moi, dit-elle."
        ]
      },
      "outfit": "#3a2f3a",
      "hair": "#b5462f",
      "if": "time:night"
    }
  ],
