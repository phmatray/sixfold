  "interactions": [
    {
      "kind": "waymark",
      "id": "kilnmouth",
      "x": 7,
      "z": 20
    },
    {
      "x": 16,
      "z": 21,
      "kind": "sign",
      "text": "South: back up to Cinderwick. Below: the Kilnmouth floor and its seal stone. Keep to the stairs.",
      "text_fr": "Sud : retour vers Mèche-Cendre. En bas : le fond de la Gueule-du-Four et sa pierre de sceau. Restez sur les marches."
    },
    {
      "x": 13,
      "z": 11,
      "kind": "sign",
      "id": "seal_kilnmouth",
      "name": "The seal stone",
      "name_fr": "La pierre de sceau",
      "dialogue": [
        {
          "lines": [
            "A hexagonal stone, warm to the touch. Each of its six faces is a colour: the fire face, toward the kiln road, glows faintly.",
            "The top is smooth, pale and blank, as if something was meant to be cut there and never was."
          ],
          "lines_fr": [
            "Une pierre hexagonale, tiède sous la main. Chacune de ses six faces a une couleur : celle du feu, tournée vers la route du four, luit faiblement.",
            "Le dessus est lisse, pâle et vide, comme si quelque chose devait y être gravé et ne l'avait jamais été."
          ]
        }
      ]
    },
    {
      "x": 4,
      "z": 15,
      "kind": "sign",
      "id": "cullet_kiln",
      "name": "Glass on the terrace",
      "name_fr": "Du verre sur la terrasse",
      "glint": "flag:lantern_asked & !item:cullet_kiln & !flag:lantern_done",
      "dialogue": [
        {
          "if": "flag:lantern_done",
          "lines": [
            "Just ash and grit now."
          ],
          "lines_fr": [
            "Plus que de la cendre et du gravier."
          ]
        },
        {
          "if": "item:cullet_kiln",
          "lines": [
            "Just ash and grit now."
          ],
          "lines_fr": [
            "Plus que de la cendre et du gravier."
          ]
        },
        {
          "if": "flag:lantern_asked",
          "lines": [
            "Half buried in the ash: a fat shard of the old green glass, thick as a thumb, warm from the rock.",
            "Clio's third piece."
          ],
          "lines_fr": [
            "À moitié enterré dans la cendre : un gros éclat de vieux verre vert, épais comme un pouce, tiède de la roche.",
            "Le troisième morceau pour Clio."
          ],
          "do": [
            "give:cullet_kiln"
          ]
        },
        {
          "lines": [
            "Shards of glass glint in the ash. The crater is full of them."
          ],
          "lines_fr": [
            "Des éclats de verre brillent dans la cendre. Le cratère en est plein."
          ]
        }
      ]
    },
    {
      "kind": "find",
      "id": "e_vent_w",
      "x": 7,
      "z": 5,
      "give": "coins:100",
      "text": "Behind the boulder, where the steam keeps everyone away all day: a pouch of Facets, dry as a bone.",
      "text_fr": "Derrière le rocher, là où la vapeur éloigne tout le monde la journée : une bourse de Facettes, sèche comme un os."
    },
    {
      "kind": "find",
      "id": "e_vent_e",
      "x": 22,
      "z": 5,
      "give": "card:cinderhorn",
      "text": "In a crack of the boulder, out of the steam's reach: a card in a tin, its corners warm.",
      "text_fr": "Dans une fente du rocher, hors de portée de la vapeur : une carte dans une boîte en fer, aux coins tièdes."
    },
    {
      "kind": "find",
      "id": "e_rim",
      "x": 19,
      "z": 0,
      "give": "pack:ember",
      "text": "On the crater's lip, tucked under a stone where only a climber would look: a sealed booster.",
      "text_fr": "Sur la lèvre du cratère, glissé sous une pierre où seul un grimpeur regarderait : un booster scellé."
    },
    {
      "kind": "find",
      "id": "e_glowash",
      "x": 16,
      "z": 12,
      "give": "card:solarlynx",
      "text": "At the pool's edge the ash glows by night, and in the glow, half melted into the glass crust: a card, perfectly unburnt.",
      "text_fr": "Au bord du bassin, la cendre luit la nuit, et dans la lueur, à moitié prise dans la croûte de verre : une carte, intacte.",
      "if": "time:night"
    },
    {
      "x": 12,
      "z": 4,
      "kind": "sign",
      "id": "rope_w",
      "name": "An old rope",
      "name_fr": "Une vieille corde",
      "dialogue": [
        {
          "lines": [
            "An old rope, knotted to an iron stake, hangs down to the terrace below. You climb down, hand over hand."
          ],
          "lines_fr": [
            "Une vieille corde, nouée à un piquet de fer, pend jusqu'à la terrasse du dessous. Vous descendez, une main après l'autre."
          ],
          "do": [
            "warp:kilnmouth:12:6:s"
          ]
        }
      ]
    }
  ],
