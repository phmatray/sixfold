  "npcs": [
    {
      "id": "hanne",
      "name": "Hanne",
      "model": "npc_shopkeeper",
      "x": 5,
      "z": 3,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#2f7fd0",
      "hair": "#d8c8a0",
      "dialogue": [
        {
          "if": "!flag:talked_hanne",
          "lines": [
            "Mm-hm-hm... oh! A customer. Sit, sit. Chowder first, questions after.",
            "Beds are through the back, and resting's free. Dawn, day, dusk or night: the tide doesn't care, so why should you?",
            "And the counter has Tide packs and a Gulfwyrm I keep for whoever can afford her."
          ],
          "lines_fr": [
            "Mm-hm-hm… oh ! Quelqu'un. Assieds-toi, assieds-toi. La chaudrée d'abord, les questions après.",
            "Les lits sont au fond, et le repos est gratuit. Aube, jour, crépuscule ou nuit : la marée s'en moque, alors pourquoi pas toi ?",
            "Et au comptoir, des boosters Marée et une Golfeguivre que je garde pour qui pourra se l'offrir."
          ],
          "do": [
            "show:inn"
          ]
        },
        {
          "if": "time:night",
          "lines": [
            "The boats are in, the lamps are lit. Brann's on the pier pretending he's fishing.",
            "A bed?"
          ],
          "lines_fr": [
            "Les bateaux sont rentrés, les lampes allumées. Brann est sur le ponton à faire semblant de pêcher.",
            "Un lit ?"
          ],
          "do": [
            "show:inn"
          ]
        },
        {
          "lines": [
            "Mm-hm-hm. That's the tide's tune. Goes out, comes back, never misses.",
            "Rest a while?"
          ],
          "lines_fr": [
            "Mm-hm-hm. C'est l'air de la marée. Elle part, elle revient, elle ne rate jamais.",
            "Tu te reposes un peu ?"
          ],
          "do": [
            "show:inn"
          ]
        }
      ]
    }
  ],
