  "interactions": [
    {"x": 5, "z": 3, "kind": "sign", "text": "Hob's Bakery. Warm bread, a bell over the door, and a queue on Saturdays."},
    {"x": 18, "z": 3, "kind": "sign", "text": "The letter office. A brass slot with a little hexagon on it. Closed till noon, as always."},
