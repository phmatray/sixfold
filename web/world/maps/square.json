  "npcs": [
    {
      "id": "hob",
      "name": "Hob",
      "model": "npc_shopkeeper",
      "tint": "#f5d7a1",
      "scale": 1.06,
      "x": 17,
      "z": 5,
      "facing": "s",
      "dialogue": [
        {
          "if": "beat:warden&flag:letter_delivered",
          "lines": [
            "The champion! Have a bun. Have two. Ottilie says heroes need feeding.",
            "I'm putting a hexagon on the seed cake. Six, actually."
          ]
        },
        {
          "if": "flag:letter_delivered",
          "lines": [
            "Bread's up! Well, it's always up. That's bread.",
            "Tell Ottilie I'll walk out to the lighthouse on Sunday. With buns."
          ]
        },
        {
          "if": "item:letter",
          "lines": [
            "A letter? That's my sister's hexagon on the wax. Ottilie!",
            "\"Dear Hob, the gulls stole another loaf.\" Ha! Of course they did.",
            "Thank you for carrying it. Here, a pack, still warm. Well, not warm. Packs aren't."
          ],
          "do": [
            "flag:letter_delivered",
            "pack:tide"
          ]
        },
        {
          "lines": [
            "Morning! Rolls, loaves, a seed cake if you're quick.",
            "My sister keeps the lighthouse out on Saltwind Boardwalk. She never visits. Too many stairs, she says."
          ]
        }
      ],
      "idle": "Idle"
    },
    {
      "id": "tansy",
      "name": "Tansy",
      "model": "npc_gardener",
      "tint": "#ffb3c7",
      "scale": 0.95,
      "x": 7,
      "z": 5,
      "facing": "s",
      "dialogue": [
        {
          "if": "beat:warden",
          "lines": [
            "A buttonhole for the champion, as promised. Well, it's a radish.",
            "The marrow isn't for sale. Not even to you."
          ]
        },
        {
          "if": "seals:3",
          "lines": [
            "Three seals! You'll want a buttonhole for the Warden. Kidding. Mostly."
          ]
        },
        {
          "lines": [
            "Apples from the orchard, pears from the meadow, and one very proud marrow.",
            "There are rivals down every road out of the meadow. The quarry folk are the toughest, or so they keep telling me."
          ]
        }
      ],
      "idle": "Idle"
    }
  ],
