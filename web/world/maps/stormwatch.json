  "npcs": [
    {
      "id": "bo",
      "name": "Bo",
      "model": "npc_sailor",
      "x": 18,
      "z": 20,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#3d5a7a",
      "hair": "#5a4030",
      "dialogue": [
        {
          "if": "item:ferry_pass",
          "lines": [
            "Pass: stamped. Twice. Ines. Wind: fair. Gullhaven: aboard."
          ],
          "lines_fr": [
            "Laissez-passer : tamponné. Deux fois. Ines. Vent : favorable. Havre-aux-Mouettes : embarque."
          ],
          "do": [
            "warp:gullhaven:26:21:w"
          ]
        },
        {
          "if": "flag:bo_asked",
          "lines": [
            "Sorry, too much salt in the mouth. I'll say it slow.",
            "The ferry runs to Gullhaven, on the Saltreach coast. The Harbour Office there stamps the passes now: two hundred and fifty Facets, and Ines Varga stamps it twice.",
            "Walk there round the coast, by the meadow and the Saltwind Boardwalk. Come back with a pass and we'll be across by noon. Lou crews the far side."
          ],
          "lines_fr": [
            "Pardon, trop de sel dans la bouche. Je le redis lentement.",
            "Le bac va jusqu'à Havre-aux-Mouettes, sur la Côte Salée. La Capitainerie de là-bas tamponne les laissez-passer, maintenant : deux cent cinquante Facettes, et Ines Varga tamponne deux fois.",
            "Vas-y par la côte, par le pré et la Promenade de Ventsalé. Reviens avec un laissez-passer et on traversera avant midi. Lou tient l'autre rive."
          ]
        },
        {
          "lines": [
            "Ferry: ready. Pass: none. Office: Gullhaven. Price: two-fifty. Lou: far side. Wind: sou'west, freshening."
          ],
          "lines_fr": [
            "Bac : paré. Laissez-passer : aucun. Bureau : Havre-aux-Mouettes. Prix : deux cent cinquante. Lou : en face. Vent : suroît, fraîchissant."
          ],
          "do": [
            "flag:bo_asked"
          ]
        }
      ]
    },
    {
      "id": "pim",
      "name": "Pim",
      "model": "npc_kid",
      "x": 12,
      "z": 14,
      "facing": "n",
      "idle": "Idle",
      "outfit": "#e2ad19",
      "hair": "#3a2a20",
      "if": "!time:night",
      "dialogue": [
        {
          "lines": [
            "I'm Pim! Quill's apprentice. Well, log-keeper. She's off duelling down the coast just now.",
            "She says the Rodspire will be hers one day. And that everyone forgets to watch their Bench.",
            "Oh. I wasn't supposed to say that. Forget I said that."
          ],
          "lines_fr": [
            "Moi, c'est Pim ! L'apprenti de Quill. Enfin, le teneur de journal. Elle est partie faire des duels sur la côte, en ce moment.",
            "Elle dit que l'Aiguille-Foudre sera à elle un jour. Et que tout le monde oublie de surveiller son Banc.",
            "Oh. Je n'étais pas censé dire ça. Oublie que j'ai dit ça."
          ]
        }
      ]
    },
    {
      "id": "wenna",
      "name": "Wenna",
      "model": "npc_sailor",
      "x": 10,
      "z": 15,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#c0582d",
      "hair": "#d8c8a0",
      "if": "!time:night",
      "dialogue": [
        {
          "lines": [
            "Mackerel! Crab! Something with too many legs, ask me later!",
            "Rhian buys half my catch for the Weathervane's stew. The other half, Bo eats while pretending to count it."
          ],
          "lines_fr": [
            "Maquereau ! Crabe ! Un truc avec trop de pattes, demande-moi plus tard !",
            "Rhian m'achète la moitié de ma pêche pour le ragoût de la Girouette. L'autre moitié, Bo la mange en faisant semblant de la compter."
          ]
        }
      ]
    },
    {
      "id": "oswin",
      "name": "Oswin",
      "model": "npc_elder",
      "x": 16,
      "z": 10,
      "facing": "e",
      "idle": "Idle",
      "outfit": "#4f5a66",
      "hair": "#d8d0c0",
      "route": [
        "e",
        "e",
        "e",
        "e",
        "s",
        "s",
        "s",
        "w",
        "w",
        "w",
        "w",
        "n",
        "n",
        "n"
      ],
      "if": "time:dusk",
      "dialogue": [
        {
          "lines": [
            "Evening! Lamps first, supper after.",
            "Forty-one lamps in Stormwatch, and the wind blows out forty. I've made my peace with it."
          ],
          "lines_fr": [
            "Bonsoir ! Les lampes d'abord, la soupe après.",
            "Quarante et une lampes à Guette-Orage, et le vent en souffle quarante. J'ai fait la paix avec ça."
          ]
        }
      ]
    },
    {
      "id": "t_greer",
      "name": "Greer",
      "model": "npc_wanderer",
      "x": 13,
      "z": 9,
      "facing": "w",
      "idle": "Idle",
      "trainer": {
        "sight": 0,
        "challenge": [
          "Energy? I carry as little as I can. Sixteen cards, no more. Can you?",
          "My house rule: at most sixteen energy cards. Three prizes. Lightweight, not lightly."
        ],
        "challenge_fr": [
          "De l'énergie ? J'en porte le moins possible. Seize cartes, pas plus. Et toi ?",
          "Ma règle maison : seize cartes Énergie au plus. Trois Récompenses. Poids plume, pas à la légère."
        ],
        "lose": [
          "Too heavy! Shed some energy and come back."
        ],
        "lose_fr": [
          "Trop lourd ! Allège ton énergie et reviens."
        ],
        "after": [
          "Fewer cards, faster hands. That's the whole secret."
        ],
        "after_fr": [
          "Moins de cartes, des mains plus rapides. C'est tout le secret."
        ]
      },
      "outfit": "#cfd8e0",
      "hair": "#e8d080",
      "dialogue": [
        {
          "if": "won:t_greer & !flag:greer_paid",
          "lines": [
            "Light, and you beat me. Fair and square.",
            "Take Fulgurex. It hits hard on very little, like you just did."
          ],
          "lines_fr": [
            "Léger, et tu m'as battue. À la loyale.",
            "Prends Fulgurion. Il frappe fort avec trois fois rien, comme toi à l'instant."
          ],
          "do": [
            "card:fulgurex",
            "flag:greer_paid"
          ]
        },
        {
          "if": "won:t_greer",
          "lines": [
            "Light, and still too much for you. Hm. No: you were lighter."
          ],
          "lines_fr": [
            "Léger, et encore trop pour toi. Hum. Non : c'est toi qui étais plus léger."
          ]
        }
      ]
    }
  ],
