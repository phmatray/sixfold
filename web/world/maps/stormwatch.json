  "interactions": [
    {
      "kind": "waymark",
      "id": "stormwatch",
      "x": 11,
      "z": 10
    },
    {
      "x": 13,
      "z": 1,
      "kind": "sign",
      "text": "North: the Thrumming Downs, and Cinderwick beyond. South: the harbour.",
      "text_fr": "Nord : les Landes Vibrantes, et Mèche-Cendre au-delà. Sud : le port."
    },
    {
      "x": 29,
      "z": 13,
      "kind": "sign",
      "text": "East: the Rodspire causeway. Mind the waves, and the lightning.",
      "text_fr": "Est : la chaussée de l'Aiguille-Foudre. Attention aux vagues, et à la foudre."
    },
    {
      "x": 7,
      "z": 13,
      "kind": "sign",
      "text": "The Weathervane. Beds, a fire, and the storm log.",
      "text_fr": "La Girouette. Des lits, un feu, et le journal des tempêtes."
    },
    {
      "kind": "find",
      "id": "st_garden",
      "x": 29,
      "z": 3,
      "give": "card:jolt_wire",
      "hidden": true,
      "text": "Under the rosemary, in the corner the wind never reaches: a card in an oilcloth wrap.",
      "text_fr": "Sous le romarin, dans le coin que le vent n'atteint jamais : une carte dans un emballage de toile cirée."
    },
    {
      "kind": "find",
      "id": "st_dock",
      "x": 21,
      "z": 21,
      "give": "coins:60",
      "text": "In the bottom of a crab pot, under the weed: Facets. Somebody's emergency fund, or a crab's.",
      "text_fr": "Au fond d'un casier à crabes, sous les algues : des Facettes. La réserve de quelqu'un, ou celle d'un crabe."
    }
  ],
