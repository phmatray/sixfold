      "if": "time:dusk",
      "dialogue": [
        {
          "lines": [
            "Evening! Lamps first, supper after.",
            "Forty-one lamps in Stormwatch, and the wind blows out forty. I've made my peace with it."
          ],
          "lines_fr": [
            "Bonsoir ! Les lampes d'abord, la soupe après.",
            "Quarante et une lampes à Guette-Orage, et le vent en souffle quarante. J'ai fait la paix avec ça."
          ]
        }
      ]
    },
    {
      "id": "t_greer",
      "name": "Greer",
      "model": "npc_wanderer",
      "x": 32,
      "z": 21,
      "facing": "w",
      "idle": "Idle",
      "duelist": {
        "sight": 0,
        "challenge": [
          "Energy? I carry as little as I can. Sixteen cards, no more. Can you?",
          "My house rule: at most sixteen energy cards. Three prizes. Lightweight, not lightly."
        ],
        "challenge_fr": [
          "De l'énergie ? J'en porte le moins possible. Seize cartes, pas plus. Et toi ?",
          "Ma règle maison : seize cartes Énergie au plus. Trois cartes Récompense. Poids plume, pas à la légère."
        ],
        "lose": [
          "Too heavy! Shed some energy and come back."
        ],
        "lose_fr": [
          "Trop lourd ! Allège ton énergie et reviens."
        ],
        "after": [
          "Fewer cards, faster hands. That's the whole secret."
        ],
        "after_fr": [
          "Moins de cartes, des mains plus rapides. C'est tout le secret."
        ]
      },
      "outfit": "#cfd8e0",
      "hair": "#e8d080",
      "dialogue": [
        {
          "if": "won:t_greer & !flag:greer_paid",
          "lines": [
            "Light, and you beat me. Fair and square.",
            "Take Fulgurex. It hits hard on very little, like you just did."
          ],
          "lines_fr": [
            "Léger, et tu m'as battue. À la loyale.",
            "Prends Fulgurion. Il frappe fort avec trois fois rien, comme toi à l'instant."
          ],
          "do": [
            "card:fulgurex",
            "flag:greer_paid"
          ]
        },
        {
          "if": "won:t_greer",
          "lines": [
            "Light, and still too much for you. Hm. No: you were lighter."
          ],
          "lines_fr": [
            "Léger, et encore trop pour toi. Hum. Non : c'est toi qui étais plus léger."
          ]
        }
      ]
    },
    {
      "id": "pim",
      "name": "Pim",
      "model": "npc_kid",
      "x": 39,
      "z": 12,
      "facing": "w",
      "idle": "Idle",
      "outfit": "#e2ad19",
      "hair": "#3a2a20",
      "dialogue": [
        {
          "lines": [
            "I'm Pim! Quill's apprentice. Well, log-keeper. She's up on the Rodspire, by the seal stone, just now.",
            "She says the Rodspire is the best seat on the coast. And that everyone forgets to watch their Bench.",
            "Oh. I wasn't supposed to say that. Forget I said that."
          ],
          "lines_fr": [
            "Moi, c'est Pim ! L'apprenti de Quill. Enfin, le teneur de journal. Elle est là-haut sur l'Aiguille-Foudre, près de la pierre de sceau, en ce moment.",
            "Elle dit que l'Aiguille-Foudre, c'est la meilleure place de la côte. Et que tout le monde oublie de surveiller son Banc.",
            "Oh. Je n'étais pas censé dire ça. Oublie que j'ai dit ça."
          ]
        }
      ],
      "barks": [
        {
          "if": "flag:sealed_quill",
          "say": "Quill's seal! The rods hum softer now.",
          "say_fr": "Le sceau de Quill ! Les tiges bourdonnent plus bas."
        }
      ],
