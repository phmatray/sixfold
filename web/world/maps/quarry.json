  "npcs": [
    {
      "id": "cinza",
      "name": "Cinza",
      "model": "rival_fire",
      "tint": "#ff9a5c",
      "scale": 1.0,
      "idle": "Idle",
      "x": 8,
      "z": 13,
      "facing": "e",
      "dialogue": [
        {
          "if": "won:cinza",
          "lines": [
            "Burnt out... You're quicker than you look.",
            "Here, my seal. Don't let it cool off in a drawer."
          ]
        },
        {
          "if": "lost:cinza",
          "lines": [
            "Too slow! The road's still warm, come race me again."
          ]
        },
        {
          "if": "beat:cinza",
          "lines": [
            "Again? Good. I've been stoking the fire."
          ],
          "do": [
            "duel:cinza"
          ]
        },
        {
          "lines": [
            "You walk like someone who's never been in a hurry.",
            "I'm Cinza. I run the kiln road every morning and duel every afternoon.",
            "Four prizes. Try to keep up."
          ],
          "do": [
            "duel:cinza"
          ]
        }
      ]
    },
    {
      "id": "orla",
      "name": "Orla",
      "model": "rival_fighting",
      "tint": "#d39058",
      "scale": 1.0,
      "idle": "Idle",
      "x": 22,
      "z": 4,
      "facing": "s",
      "dialogue": [
        {
          "if": "won:orla",
          "lines": [
            "You cracked the bedrock. Respect.",
            "My seal. Earned, not quarried."
          ]
        },
        {
          "if": "lost:orla",
          "lines": [
            "Solid stone stays solid. Come back with a sharper pick."
          ]
        },
        {
          "if": "!open:orla",
          "lines": [
            "Not yet. The quarry only opens to those with three seals.",
            "Go on, the others won't beat themselves."
          ]
        },
        {
          "if": "beat:orla",
          "lines": [
            "Another shift? Five prizes, same as ever."
          ],
          "do": [
            "duel:orla"
          ]
        },
        {
          "lines": [
            "Hard hat zone. Well, it would be, if I had a hard hat.",
            "Orla. I run this quarry. Five prizes, no shortcuts."
          ],
          "do": [
            "duel:orla"
          ]
        }
      ]
    },
    {
      "id": "flint",
      "name": "Flint",
      "model": "npc_rival",
      "tint": "#d9a066",
      "scale": 1.02,
      "x": 19,
      "z": 12,
      "facing": "w",
      "dialogue": [
        {
          "if": "item:field_lens",
          "lines": [
            "Found something shiny up top? The falcons drop all sorts."
          ]
        },
        {
          "lines": [
            "Every block in Brightwell's fountain came out of this pit. I cut half of them.",
            "The high ledge has the best view. Falcons, mostly. And a birdwatcher's lost things, I'd bet."
          ]
        }
      ],
      "idle": "Idle"
    }
