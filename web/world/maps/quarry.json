  "interactions": [
    {
      "x": 3,
      "z": 0,
      "kind": "sign",
      "id": "lens_rock",
      "name": "A glint under a rock",
      "glint": "!item:field_lens",
      "dialogue": [
        {
          "if": "item:field_lens",
          "lines": [
            "Just pebbles and a falcon feather now."
          ]
        },
        {
          "lines": [
            "Something brass is wedged under the rock... a birdwatcher's field lens!",
            "Somebody must be squinting at blurs without it."
          ],
          "do": [
            "give:field_lens"
          ]
        }
      ]
    },
    {"x": 15, "z": 19, "kind": "sign", "text": "Emberstep Quarry. South: back to Sixfold Meadow. The steps lead up to the ledges; mind the edges."}
  ],
  "warps": [],
