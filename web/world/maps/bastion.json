  "spawn": {
    "x": 22,
    "z": 30,
    "facing": "n"
  },
  "interactions": [
    {
      "x": 19,
      "z": 4,
      "kind": "sign",
      "text": "The seal stone of the Stonebacks. Six faces, the Stone face scarred as if by knuckles. The seventh, on top, is blank, and colder than the rest.",
      "text_fr": "La pierre du sceau des Échines. Six faces, la face Roc balafrée comme par des poings. La septième, au sommet, est nue, et plus froide que les autres."
    },
    {
      "kind": "find",
      "id": "sn_menhir",
      "x": 19,
      "z": 8,
      "give": "coins:50",
      "hidden": true,
      "text": "At the foot of the south menhir, under a flat stone the crew uses as a step: a little cache of Facets, wrapped in an oilcloth.",
      "text_fr": "Au pied du menhir sud, sous une pierre plate dont l'équipe se sert comme marche : une petite réserve de Facettes, enveloppée dans une toile cirée."
    },
    {
      "kind": "waymark",
      "id": "bastion",
      "x": 27,
      "z": 5
    },
    {
      "kind": "find",
      "id": "sn_moon",
      "x": 33,
      "z": 3,
      "give": "card:cragmastiff",
      "text": "Moonlight falls on the cut slate and every seam shines like a vein of silver. In the brightest seam, wedged in a crack: a card, cold to the touch.",
      "text_fr": "La lune tombe sur l'ardoise taillée et chaque veine brille comme de l'argent. Dans la plus brillante, coincée dans une fente : une carte, froide au toucher.",
      "if": "time:night"
    },
    {
      "x": 37,
      "z": 6,
      "kind": "sign",
      "id": "chute",
      "name": "An old spoil chute",
      "name_fr": "Une vieille goulotte à déblais",
      "dialogue": [
        {
          "lines": [
            "A plank chute, polished by a century of spoil, drops from the top terrace to the works below. You sit, push off, and slide all the way down to the road for Anvilstead."
          ],
          "lines_fr": [
            "Une goulotte de planches, polie par un siècle de déblais, plonge de la terrasse du haut jusqu'au chantier. Vous vous asseyez, vous poussez, et vous glissez jusqu'à la route de Bourg-l'Enclume."
          ],
          "do": [
            "warp:bastion:37:16:e"
          ]
        }
      ]
    },
    {
      "x": 5,
      "z": 16,
      "kind": "sign",
      "id": "works_office",
      "name": "The Bastion Works",
      "name_fr": "Le chantier du Bastion",
      "dialogue": [
        {
          "lines": [
            "A board on the door: \"BASTION WORKS. Day shift: Orla's crew. Night shift: Morwen's. Visitors: wear a hat.\" There is a hook with one hat on it."
          ],
          "lines_fr": [
            "Un panneau sur la porte : « CHANTIER DU BASTION. Équipe de jour : Orla. Équipe de nuit : Morwen. Visiteurs : portez un chapeau. » Il y a un crochet avec un chapeau dessus."
          ]
        }
      ]
    },
    {
      "x": 30,
      "z": 12,
      "kind": "sign",
      "id": "half_block",
      "name": "A half-cut block",
      "name_fr": "Un bloc à moitié taillé",
      "dialogue": [
        {
          "lines": [
            "A block of slate as big as a cart, split halfway along a line of iron wedges. The wedges are rusted in. Whoever was cutting it stopped one morning and never came back."
          ],
          "lines_fr": [
            "Un bloc d'ardoise gros comme un wagonnet, fendu à moitié le long d'une ligne de coins de fer. Les coins sont rouillés dedans. Celui qui le taillait s'est arrêté un matin et n'est jamais revenu."
          ]
        }
      ]
    },
    {
      "x": 25,
      "z": 29,
      "kind": "sign",
      "text": "South: The Elder Ring, at the foot of the cliff. There's a wall of old pegs down; you'd need gloves to use it. East: Anvilstead.",
      "text_fr": "Sud : Le Cercle des Anciens, au pied de la falaise. Il y a une paroi de vieux pitons pour descendre ; il faudrait des gants. Est : Bourg-l'Enclume."
    },
    {
      "x": 37,
      "z": 14,
      "kind": "sign",
      "text": "East: Anvilstead, along the rail road. Up the terraces: the stone ring and the seal.",
      "text_fr": "Est : Bourg-l'Enclume, par la route des rails. En haut des gradins : le cercle de pierres et le sceau."
    }
  ],
