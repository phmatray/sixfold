  "npcs": [
    {
      "id": "kessa",
      "name": "Kessa",
      "model": "npc_worker",
      "x": 22,
      "z": 4,
      "facing": "s",
      "idle": "Idle",
      "outfit": "#a8642f",
      "hair": "#d8c8a0",
      "dialogue": [
        {
          "if": "!beat:orla & !flag:talked_kessa",
          "more": true,
          "lines": [
            "Kessa. Shift boss. Orla's back up at her seal, by the stone on the top terrace. She's done minding the old face at Emberstep for the season, and you'll have heard her before you saw her.",
            "I still keep the ring. Seven stones round one seal, and the crew swears none of them were ever moved. They were here before the quarry."
          ],
          "lines_fr": [
            "Kessa. Cheffe d'équipe. Orla est remontée à son sceau, près de la pierre, sur la haute terrasse. Elle a fini de surveiller le vieux front de taille de Pas-de-Braise pour la saison, et tu l'auras entendue avant de la voir.",
            "Moi, je garde toujours le cercle. Sept pierres autour d'un sceau, et l'équipe jure qu'aucune n'a jamais été déplacée. Elles étaient là avant la carrière."
          ]
        },
        {
          "if": "!beat:orla & !open:orla",
          "lines": [
            "Orla won't even look up until you carry three seals. Come back with them."
          ],
          "lines_fr": [
            "Orla ne lèvera même pas les yeux avant que tu portes trois sceaux. Reviens quand tu les auras."
          ]
        },
        {
          "if": "!beat:orla & open:orla & earned:orla",
          "lines": [
            "The crews have been talking: you've done the rounds of the Stonebacks. Orla's expecting you up top."
          ],
          "lines_fr": [
            "Les équipes en parlent : tu as fait le tour des Échines de Pierre. Orla t'attend là-haut."
          ]
        },
        {
          "if": "!beat:orla & open:orla & !earned:orla & bested:orla:2",
          "lines": [
            "Orla doesn't duel just anyone off the road. Beat one more duelist of the Stonebacks and she'll see you on the top terrace."
          ],
          "lines_fr": [
            "Orla n'affronte pas le premier venu. Bats encore un duelliste des Échines de Pierre et elle te recevra sur la haute terrasse."
          ]
        },
        {
          "if": "!beat:orla & open:orla & !earned:orla & bested:orla:1",
          "lines": [
            "Orla doesn't duel just anyone off the road. Beat two more duelists of the Stonebacks and she'll see you on the top terrace."
          ],
          "lines_fr": [
            "Orla n'affronte pas le premier venu. Bats encore deux duellistes des Échines de Pierre et elle te recevra sur la haute terrasse."
          ]
        },
        {
          "if": "!beat:orla & open:orla & !earned:orla & bested:orla:0",
          "lines": [
            "Orla doesn't duel just anyone off the road. Beat three more duelists of the Stonebacks and she'll see you on the top terrace."
          ],
          "lines_fr": [
            "Orla n'affronte pas le premier venu. Bats encore trois duellistes des Échines de Pierre et elle te recevra sur la haute terrasse."
          ]
        },
        {
          "if": "time:night",
          "lines": [
            "Night shift's Morwen's. I'm only up because the stone hums after dark. Listen. Hear it?",
            "Orla says it's the mountain settling. Orla says a lot of things."
          ],
          "lines_fr": [
            "L'équipe de nuit, c'est Morwen. Je ne suis debout que parce que la pierre bourdonne après la tombée de la nuit. Écoute. Tu l'entends ?",
            "Orla dit que c'est la montagne qui se tasse. Orla dit beaucoup de choses."
          ]
        },
        {
          "lines": [
            "Kessa. Shift boss. Orla's back up at her seal, by the stone on the top terrace. She's done minding the old face at Emberstep for the season, and you'll have heard her before you saw her.",
            "I still keep the ring. Seven stones round one seal, and the crew swears none of them were ever moved. They were here before the quarry."
          ],
          "lines_fr": [
            "Kessa. Cheffe d'équipe. Orla est remontée à son sceau, près de la pierre, sur la haute terrasse. Elle a fini de surveiller le vieux front de taille de Pas-de-Braise pour la saison, et tu l'auras entendue avant de la voir.",
            "Moi, je garde toujours le cercle. Sept pierres autour d'un sceau, et l'équipe jure qu'aucune n'a jamais été déplacée. Elles étaient là avant la carrière."
          ]
        }
      ]
    },
    {
      "id": "t_petra",
      "name": "Petra",
      "model": "npc_worker",
      "x": 16,
      "z": 20,
      "facing": "e",
      "idle": "Idle",
      "trainer": {
        "sight": 4,
