  "npcs": [
    {
      "idle": "Idle",
      "id": "hollis",
      "name": "Hollis",
      "model": "npc_elder",
      "outfit": "#9a4a32",
      "x": 5,
      "z": 3,
      "facing": "s",
      "dialogue": [
        {
          "if": "!flag:talked_hollis",
          "do": [
            "show:inn"
          ],
          "lines": [
            "Welcome to the Hearth Rooms! Beds upstairs, soup on the stove, and the quietest clock in Brightwell.",
            "Rest as long as you like: it's free for anyone who duels. Sleep till morning, or till the night folk come out."
          ],
          "lines_fr": [
            "Bienvenue aux Chambres de l'Âtre ! Des lits à l'étage, de la soupe sur le feu, et l'horloge la plus discrète de Clairpuits.",
            "Repose-toi autant que tu veux : c'est gratuit pour qui joue aux cartes. Dors jusqu'au matin, ou jusqu'à ce que les gens de la nuit sortent."
          ]
        },
        {
          "if": "time:night",
          "do": [
            "show:inn"
          ],
          "lines": [
            "Still up? The lamps are lit, and so's the kettle.",
            "There's a bed free if you want one."
          ],
          "lines_fr": [
            "Encore debout ? Les lampes sont allumées, la bouilloire aussi.",
            "Il y a un lit de libre, si tu veux."
          ]
        },
        {
          "do": [
            "show:inn"
          ],
          "lines": [
            "Back again! Your room's just as you left it.",
            "A rest, then?"
          ],
          "lines_fr": [
            "Te revoilà ! Ta chambre est comme tu l'as laissée.",
            "Tu te reposes un peu ?"
          ]
        }
      ]
    },
    {
      "id": "wendel",
      "name": "Wendel",
      "model": "npc_elder",
      "outfit": "#5f7a4a",
      "hair": "#d9d2c4",
      "x": 1,
      "z": 4,
      "facing": "e",
      "sit": true,
      "if": "!time:day",
      "dialogue": [
        {
          "lines": [
            "Supper, then the fire, then bed. The best hours of the day are the ones after it.",
            "I'll be back on my bench when the light is."
          ],
          "lines_fr": [
            "Le souper, puis le feu, puis au lit. Les meilleures heures de la journée, ce sont celles d'après.",
            "Je retournerai sur mon banc quand la lumière y sera."
          ]
        }
      ]
    }
  ],
