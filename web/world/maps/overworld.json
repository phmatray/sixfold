  "interactions": [
    {
      "x": 16,
      "z": 11,
      "kind": "sign",
      "text": "Sixfold Meadow. The duel hall up the path has duels, snacks and shoes. Six rivals wait on the roads out: the trail, the boardwalk and the quarry.",
      "text_fr": "Pré de Sixfold. En haut du chemin, la salle des duels : duels, en-cas et chaussures. Six rivaux attendent sur les routes : le sentier, la promenade et la carrière."
    },
    {
      "x": 2,
      "z": 17,
      "kind": "sign",
      "text": "West: Fernhollow Trail, the woods and the stream.",
      "text_fr": "Ouest : Sentier de Creuse-Fougère, les bois et le ruisseau."
    },
    {
      "x": 24,
      "z": 19,
      "kind": "sign",
      "text": "North: Emberstep Quarry. East: Saltwind Boardwalk and the sea.",
      "text_fr": "Nord : Carrière de Pas-de-Braise. Est : Promenade de Ventsalé et la mer."
    },
    {
      "x": 14,
      "z": 21,
      "kind": "sign",
      "text": "South: Brightwell Square, the bakery and the market.",
      "text_fr": "Sud : Place de Clairpuits, la boulangerie et le marché."
    }
  ],
