  "npcs": [
    {
      "id": "wren",
      "name": "Wren",
      "model": "npc_wanderer",
      "tint": "#7fb6ff",
      "scale": 0.94,
      "x": 6,
      "z": 13,
      "facing": "e",
      "idle": "Idle",
      "route": [
        "e",
        "e",
        "s",
        "s",
        "w",
        "w",
        "n",
        "n"
      ],
      "dialogue": [
        {
          "if": "!flag:talked_wren",
          "lines": [
            "Lovely day for a walk. I do this loop a hundred times before lunch.",
            "Some call it a rut. I call it a route."
          ],
          "lines_fr": [
            "Belle journée pour marcher. Je fais cette boucle cent fois avant midi.",
            "On dit que je tourne en rond. Moi, je dis que je fais ma ronde."
          ]
        },
        {
          "if": "beat:warden",
          "lines": [
            "The champion, out on my loop! Everyone will say I overtook you.",
            "I won't correct them."
          ],
          "lines_fr": [
            "Champion, sur ma boucle ! Tout le monde dira que je t'ai mis un tour.",
            "Je ne les contredirai pas."
          ]
        },
        {
          "if": "item:running_shoes",
          "lines": [
            "Are those running shoes? Don't lap me, it's rude."
          ],
          "lines_fr": [
            "Ce sont des chaussures de course ? Ne me mets pas un tour, c'est malpoli."
          ]
        },
        {
          "lines": [
            "Round and round. Still lovely."
          ],
          "lines_fr": [
            "Ça tourne, ça tourne. Toujours aussi joli."
          ]
        }
      ]
    },
    {
      "id": "pip",
      "name": "Pip",
      "model": "npc_kid",
      "tint": "#ffd36e",
      "scale": 0.82,
      "x": 9,
      "z": 19,
      "facing": "s",
      "idle": "Idle",
      "route": [
        "e",
        "e",
        "w",
        "w"
      ],
      "dialogue": [
        {
          "if": "!flag:talked_pip",
          "lines": [
            "I'm practising my shuffle. Watch! ...Okay, don't watch."
          ],
          "lines_fr": [
            "Je m'entraîne à mélanger. Regarde ! …Bon, regarde pas."
          ]
        },
        {
          "if": "beat:warden",
          "lines": [
            "You beat the Hex Warden? With cards? Real cards?",
            "Sable runs a Gauntlet in the back room now. I'm not ready. I'll watch."
          ],
          "lines_fr": [
            "T'as battu la Gardienne des Six ? Avec des cartes ? Des vraies ?",
            "Sable fait passer l'Épreuve dans l'arrière-salle. C'est pas pour moi, pas encore. Je regarde."
          ]
        },
        {
          "if": "seals:1",
          "lines": [
            "Is that a seal? A real one? Bramble never gave ME one.",
            "...I never beat Bramble. Shh."
          ],
          "lines_fr": [
            "C'est un sceau ? Un vrai ? Bramble m'en a jamais donné, à MOI.",
            "…J'ai jamais battu Bramble. Chut."
          ]
        },
        {
          "lines": [
            "One day I'll beat whoever sits at that duel table. One day."
          ],
          "lines_fr": [
            "Un jour, je battrai celui qui s'assoit à cette table de duel. Un jour."
          ]
        }
      ]
    },
    {
      "id": "moss",
      "name": "Moss",
      "model": "npc_gardener",
      "tint": "#9be08a",
      "scale": 1.04,
      "x": 21,
      "z": 12,
      "facing": "w",
      "idle": "Idle",
      "dialogue": [
        {
          "if": "beat:warden",
          "lines": [
            "The champion, in my flowerbeds. I'll allow it, just this once.",
            "Bramble says the hedges grew back thicker the day you won. Coincidence, surely."
          ],
          "lines_fr": [
            "Champion ou pas, on ne marche pas sur mes plates-bandes. Bon, pour cette fois.",
            "Bramble dit que les haies ont repoussé plus drues le jour de ta victoire. Pure coïncidence."
          ]
        },
        {
          "if": "item:running_shoes",
          "lines": [
            "New shoes? Lovely. Now keep them out of my beds."
          ],
          "lines_fr": [
            "Des chaussures neuves ? Charmant. Maintenant, tiens-les loin de mes plates-bandes."
          ]
        },
        {
          "lines": [
            "These flowers took three summers to settle in.",
            "Juniper's shop up the path sells more than seeds. Ask about shoes."
          ],
          "lines_fr": [
            "Ces fleurs ont mis trois étés à s'installer.",
            "La boutique de Juniper, en haut du chemin, ne vend pas que des graines. Demande-lui des chaussures."
          ]
        }
      ]
    }
  ],
