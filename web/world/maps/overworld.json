    {
      "x": 13,
      "z": 10,
      "to": "shop",
      "label": "Go inside",
      "spawn": {
        "x": 5,
        "z": 7,
        "facing": "n"
      }
    }
  ],
  "npcs": [
    {
      "id": "wren",
      "name": "Wren",
      "model": "npc_wanderer",
      "tint": "#7fb6ff",
      "scale": 0.94,
      "x": 6,
      "z": 13,
      "facing": "e",
      "idle": "Idle",
      "route": [
        "e",
        "e",
        "s",
        "s",
        "w",
        "w",
        "n",
        "n"
      ],
      "dialogue": [
        {
          "if": "!flag:talked_wren",
          "lines": [
            "Lovely day for a walk. I do this loop a hundred times before lunch.",
            "Some call it a rut. I call it a route."
          ]
        },
        {
          "if": "item:running_shoes",
          "lines": [
            "Are those running shoes? Don't lap me, it's rude."
          ]
        },
        {
          "lines": [
            "Round and round. Still lovely."
          ]
        }
      ]
    },
    {
      "id": "pip",
      "name": "Pip",
      "model": "npc_kid",
      "tint": "#ffd36e",
      "scale": 0.82,
      "x": 9,
      "z": 19,
      "facing": "s",
      "idle": "Idle",
      "route": [
        "e",
        "e",
        "w",
        "w"
      ],
      "dialogue": [
        {
          "if": "!flag:talked_pip",
          "lines": [
            "I'm practising my shuffle. Watch! ...Okay, don't watch."
          ]
        },
        {
          "if": "seals:1",
          "lines": [
            "Is that a seal? A real one? Bramble never gave ME one.",
            "...I never beat Bramble. Shh."
          ]
        },
        {
          "lines": [
            "One day I'll beat whoever sits at that duel table. One day."
          ]
        }
      ]
    },
    {
      "id": "moss",
      "name": "Moss",
      "model": "npc_gardener",
      "tint": "#9be08a",
      "scale": 1.04,
      "x": 21,
      "z": 12,
      "facing": "w",
      "idle": "Idle",
      "dialogue": [
        {
          "if": "item:running_shoes",
          "lines": [
            "New shoes? Lovely. Now keep them out of my beds."
          ]
        },
        {
          "lines": [
            "These flowers took three summers to settle in.",
            "Juniper's shop up the path sells more than seeds. Ask about shoes."
          ]
        }
      ]
    },
    {
      "id": "bramble",
      "name": "Bramble",
      "model": "rival_grass",
      "tint": "#8fd17a",
      "scale": 1.0,
      "x": 5,
      "z": 8,
      "facing": "s",
      "idle": "Idle",
      "dialogue": [
        {
          "if": "won:bramble",
          "lines": [
            "Well! You pruned me right back.",
            "Take my seal. Five more rivals carry one each."
          ]
        },
        {
          "if": "lost:bramble",
          "lines": [
            "Ha, tangled up! Happens to everyone the first time.",
            "Catch your breath and come try again."
          ]
        },
        {
          "if": "beat:bramble",
          "lines": [
            "Back for more thorns? Two prizes, same as before."
          ],
          "do": [
            "duel:bramble"
          ]
        },
        {
          "lines": [
            "Mind the hedge, it bites. Only a little.",
            "I'm Bramble. I keep this side of the meadow tidy, and I keep a deck for visitors.",
            "A short one, two prizes. Shall we?"
          ],
          "do": [
            "duel:bramble"
          ]
        }
      ]
    },
    {
      "id": "cinza",
      "name": "Cinza",
      "model": "rival_fire",
      "tint": "#ff9a5c",
      "scale": 1.0,
      "x": 16,
      "z": 19,
      "facing": "w",
      "idle": "Idle",
      "dialogue": [
        {
          "if": "won:cinza",
          "lines": [
            "Burnt out... You're quicker than you look.",
            "Here, my seal. Don't let it cool off in a drawer."
          ]
        },
        {
          "if": "lost:cinza",
          "lines": [
            "Too slow! The road's still warm, come race me again."
          ]
        },
        {
          "if": "beat:cinza",
          "lines": [
            "Again? Good. I've been stoking the fire."
          ],
          "do": [
            "duel:cinza"
          ]
        },
        {
          "lines": [
            "You walk like someone who's never been in a hurry.",
            "I'm Cinza. I run the kiln road every morning and duel every afternoon.",
            "Four prizes. Try to keep up."
          ],
          "do": [
            "duel:cinza"
          ]
        }
      ]
    },
    {
      "id": "quill",
      "name": "Quill",
      "model": "rival_lightning",
      "tint": "#ffd84d",
      "scale": 1.0,
      "x": 24,
      "z": 6,
      "facing": "w",
      "idle": "Idle",
      "dialogue": [
        {
          "if": "won:quill",
          "lines": [
            "Well. I'll be recording that one as a downpour.",
            "My seal is yours. Mark it in your own notebook."
          ]
        },
        {
          "if": "lost:quill",
          "lines": [
            "Clear skies for me today. Check the forecast and come back."
          ]
        },
        {
          "if": "!open:quill",
          "lines": [
            "Hold on. You carry fewer than three seals.",
            "I only write up duels worth reading. Come back with three."
          ]
        },
        {
          "if": "beat:quill",
          "lines": [
            "New page, same storm. Ready?"
          ],
          "do": [
            "duel:quill"
          ]
        },
        {
          "lines": [
            "Clouds are stacking up over the hills. Good dueling weather.",
            "I'm Quill. I note the wind, the rain and every duel I play.",
            "Four prizes, and I'll be writing it all down."
          ],
          "do": [
            "duel:quill"
          ]
        }
      ]
    },
    {
      "id": "orla",
      "name": "Orla",
      "model": "rival_fighting",
      "tint": "#d39058",
      "scale": 1.0,
      "x": 3,
      "z": 20,
      "facing": "n",
      "idle": "Idle",
      "dialogue": [
        {
          "if": "won:orla",
          "lines": [
            "You cracked the bedrock. Respect.",
            "My seal. Earned, not quarried."
          ]
        },
        {
          "if": "lost:orla",
          "lines": [
            "Solid stone stays solid. Come back with a sharper pick."
          ]
        },
        {
          "if": "!open:orla",
          "lines": [
            "Not yet. The quarry only opens to those with three seals.",
            "Go on, the others won't beat themselves."
          ]
        },
        {
          "if": "beat:orla",
          "lines": [
            "Another shift? Five prizes, same as ever."
          ],
          "do": [
            "duel:orla"
          ]
        },
        {
          "lines": [
            "Hard hat zone. Well, it would be, if I had a hard hat.",
            "Orla. I run the quarry past the trees. Five prizes, no shortcuts."
          ],
          "do": [
            "duel:orla"
          ]
        }
      ]
    }
  ],
