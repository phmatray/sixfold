          "do": [
            "flag:cairn_6",
            "coins:60",
            "sfx:chime"
          ]
        },
        {
          "lines": [
            "A cairn of slate, with a little red pennant. Walkers add a stone as they pass, for luck and to show the way. You find a flat one and add it."
          ],
          "lines_fr": [
            "Un cairn d'ardoise, avec un petit fanion rouge. Les marcheurs ajoutent une pierre en passant, pour la chance et pour montrer le chemin. Vous en trouvez une plate et vous l'ajoutez."
          ],
          "do": [
            "flag:cairn_6"
          ]
        }
      ]
