        ],
        "win": [
          "Fool's gold. Me, I mean. Fair win."
        ],
        "win_fr": [
          "De l'or des fous. Moi, je veux dire. Belle victoire."
        ],
        "lose": [
          "Struck it rich! Well. Struck it."
        ],
        "lose_fr": [
          "J'ai fait fortune ! Enfin. J'ai frappé."
        ],
        "after": [
          "Every stone on this pass has a story. Most of them say \"I fell off the mountain.\""
        ],
        "after_fr": [
          "Chaque pierre de ce col a une histoire. La plupart disent : « Je suis tombée de la montagne. »"
        ]
      },
      "outfit": "#8a6a4a",
      "hair": "#c8a060"
    },
    {
      "id": "t_ulric",
      "name": "Ulric",
      "model": "npc_elder",
      "x": 8,
      "z": 27,
      "facing": "s",
      "idle": "Idle",
      "duelist": {
        "sight": 3,
        "challenge": [
