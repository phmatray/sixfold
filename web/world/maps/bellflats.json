      "trainer": {
        "sight": 2,
        "challenge": [
          "Mind the nets! Oh, you're not a gull. Good.",
          "I mend, I watch, I duel. Two prizes, and my knots never slip."
        ],
        "challenge_fr": [
          "Attention aux filets ! Ah, tu n'es pas une mouette. Tant mieux.",
          "Je ramende, je surveille, je fais des duels. Deux Récompenses, et mes nœuds ne glissent jamais."
        ],
        "win": [
          "Slipped a knot. That never happens."
        ],
        "win_fr": [
          "Un nœud a glissé. Ça n'arrive jamais."
        ],
        "lose": [
          "Tight as a bowline. Come back when you've mended your deck."
        ],
        "lose_fr": [
          "Serré comme un nœud de chaise. Reviens quand tu auras ramendé ton deck."
        ],
        "after": [
          "A net's just holes tied together. So's a good deck, if you think about it. I try not to."
        ],
        "after_fr": [
          "Un filet, c'est juste des trous attachés ensemble. Un bon deck aussi, quand on y pense. J'essaie de ne pas y penser."
        ]
      },
      "outfit": "#3d6f8f",
      "hair": "#8a6a4a"
    },
    {
      "id": "t_liesl",
      "name": "Liesl",
      "model": "npc_gardener",
      "x": 13,
      "z": 14,
      "facing": "e",
