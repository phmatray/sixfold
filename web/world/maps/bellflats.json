          "Rattrape-toi. Deux Récompenses, vite, avant que la marée tourne."
        ],
        "win": [
          "Dug myself a hole there. Well played."
        ],
        "win_fr": [
          "Je me suis creusé un trou, là. Bien joué."
        ],
        "lose": [
          "Ha! Back to the boardwalk with you, the sea's coming."
        ],
        "lose_fr": [
          "Ha ! Retourne sur le ponton, la mer arrive."
        ],
        "after": [
          "Low water, high water. Six hours each, near enough. I've never been late. Well. Once. I swam."
        ],
        "after_fr": [
          "Basse mer, pleine mer. Six heures chacune, à peu près. Je n'ai jamais été en retard. Enfin. Une fois. J'ai nagé."
