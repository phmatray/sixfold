# Sixfold placement rules — read by tools/placement.mjs (node tools/placement.mjs web/world [--map=<name>]).
#
# Minecraft places a feature only where its placement modifiers hold, and a block only where it can survive
# (a torch needs a wall, sugar cane needs water beside it). These rules run that backwards: every prop already
# on a map is checked against the rules written for its asset, and each rule it breaks is a finding.
#
#   Minecraft                              here
#   #minecraft:logs (a tag)                tag tree = pine birch …          then #tree
#   biome filter                           when region(ember) / kind(town) / outdoor / indoor / cave / wild
#   heightmap                              need grounded                  (rests on the floor, a deck or a prop)
#   block_predicate_filter + offset        on(…) touches(…) front(n, …) behind(n, …) beside(…)
#   environment_scan / in_square           near(r, …)  dist(…) <= r
#   count / rarity_filter (spacing)        count(r, …) == 0
#   can_survive / would_survive            the whole rule
#
# A rule:
#
#   rule <id> <error|warn|info> "<why, in one line>"
#     for <asset> | <asset> | #tag | *          the props it judges
#     when <expr>                               only where this holds (repeatable; all must hold)
#     unless <expr>                             not where this holds (repeatable)
#     need <expr>                               must hold, else a finding (repeatable; the first that fails is named)
#
# An expression: predicates joined by `and`, `or`, `not` and ( ), and numbers compared with < <= > >= == !=.
#
#   is(T)          the prop itself is one of T (an asset, a #tag, or deck)   (unless is(#afloat | deck))
#   on(T)          every tile of the footprint matches T         touches(T)    some tile of it does
#   near(r, T)     some tile within r of the footprint (itself included; the prop never matches itself)
#   front(T)       the row in front of its face (+Z at rot 0)    front(n, T)   any of the n rows in front
#   behind(T)      the row behind it, behind(n, T) the n rows    beside(T)     the columns either side
#   count(r, T)    how many within r (a prop counts once, a tile once per tile)
#   dist(T)        tiles to the nearest T (0 under it)           y  height  rot   the prop's base, metres, turn
#   grounded       rests on the floor, a deck or another prop's top, and no footprint tile rises over its base
#   flat           its footprint is all one floor height         has(key)      the prop's JSON has that key
#   outdoor  indoor  cave  wild   kind(a | b)  region(a | b)  map(a | b)
#
# T (a target) is terms joined by `|`: an asset name, a #tag, tile:<glyphs> (tile:pr=H), paint:<glyphs>, or a
# builtin: door, warp, npc, spot, exit, solid, open, edge (off the map), prop (any other prop), deck, wet (water,
# or flat ground the map lays as wet sand, mud or marsh). near(1, edge) means "on the map's border row".
# `#` followed by a space starts a comment. Severity: `error` fails `--strict`, `warn` is for a person to judge.

# ---------- Tags ----------

tag path      = tile:pr=H paint:pr deck
tag trail     = tile:p paint:p                      # a path's walking line: posts and lamps keep off it (they may stand on a plaza or a deck)
tag paved     = tile:pr=H paint:pr deck             # trodden, paved or built ground (paths, squares, boardwalks, piers, decks): nothing grows on it
tag water     = tile:~
tag wall      = tile:#WV
tag house     = cottage workshop house terrace_house harbour_house lake_house treehouse kiln observatory lighthouse bell_tower headframe
tag tree      = tree pine birch willow ash_pine standing_tree blossom_tree wishing_tree
tag scatter   = bush bush_dark heather flowers rock rock_basalt reeds moonflower stump mushroom_ring
tag blooms    = flowers heather moonflower blossom_tree vegetable_patch wisteria_arch flower_planter
tag afloat    = reeds lake_house harbour_house boat buoy ferry water_lilies floating_lantern rock_sea bridge rope_bridge boardwalk lighthouse bell_tower cliff_falls
tag harbour   = tile:H= boardwalk ferry boat              # what gear serves (not the gear itself)
tag indoors   = lamp plant chair bed bookcase shelf rug counter display_case oven cloth_rack dress_form workbench light_box net_locker boot_rack
tag on_a_wall = bookcase shelf display_case net_locker boot_rack oven cloth_rack light_box
tag at_table  = duel_table chart_table workbench counter cobbler_bench soup_cauldron chowder_stove
tag raised    = canopy_deck rope_bridge ladder               # held up by trees and posts, by design
tag market    = stall stall_b curio_cabinet
tag work      = #house #market #harbour #at_table minecart rail kiln glass_furnace glass_rack cullet anvil door net_rack crab_pots   # not crates: two stray crates don't make a trade

# ---------- Light — l'éclairage suit l'usage (WORLD_RULES §2) ----------

rule lamp.path error "a street lantern lights a path or a plaza (2.1)"
  for lantern
  when outdoor
  need near(2, #path)

rule lamp.wild error "out of town, a lantern needs a reason: a door, a bridge, a camp (2.3)"
  for lantern
  when wild
  need has(why)

rule lamp.clump warn "two street lanterns under 4 tiles apart are a clump; the rhythm is one every 5-7 (2.2)"
  for lantern
  unless has(why) or near(2, door)                  # a pair flanking a door is the rule, not a clump (2.2)
  need count(3, lantern) == 0

rule lamp.edge warn "a lantern stands at the edge of the path, never in the walking line"
  for lantern
  need not touches(#trail)

rule lamp.cave error "nothing underground could power a street lamp (2.6)"
  for lantern | lamp
  need not cave

rule lamp.timber warn "a miner's oil lantern hangs on the mine's timbers"
  for oil_lantern
  need near(1, support_beam | rail | headframe | cave_mouth | cave_mouth_slate)

# ---------- Signs — panneaux (WORLD_RULES §3) ----------

rule sign.by-path warn "a sign stands beside the path, at its edge (3.3)"
  for signpost | sign
  when outdoor
  need near(1, #path)

rule sign.off-path error "a sign never stands on the path (3.3)"
  for signpost | sign
  need not touches(#trail)

rule sign.faces warn "a sign faces the path or the camera (3.3)"
  for signpost | sign
  when outdoor
  need rot == 0 or front(2, #path)

rule sign.shop warn "a shop's or an inn's sign hangs by its door (1.5)"
  for inn_sign | hanging_sign
  need near(2, door)

# ---------- Dressing — props cluster by function (WORLD_RULES 6.3) ----------

rule planter.doorstep warn "a planter dresses a doorstep or a house front"
  for flower_planter
  need near(2, door) or near(1, #house)

rule planter.off-path warn "a planter stands beside the path, not on it"
  for flower_planter
  need not touches(#trail)

rule bench.view warn "a bench looks onto something: a path, a square, water, a fountain"
  for bench
  when outdoor
  need front(3, #path | #water | fountain | well | waymark | seal_stone | campfire)

rule bench.seat warn "you sit on a bench from its front: that tile is open"
  for bench
  need front(open | rug | deck)

rule chair.seat warn "a chair faces open floor or its table"
  for chair
  need front(open | rug | deck | #at_table)

rule chair.table info "a chair goes with a table, a desk or a counter"
  for chair
  need near(1, #at_table)

rule furniture.wall warn "a bookcase, a shelf or a locker stands against a wall"
  for #on_a_wall
  need behind(#wall | edge) or beside(#wall | edge) or behind(#on_a_wall)

rule furniture.indoor error "room furniture stays indoors"
  for #indoors
  need indoor

rule crates.purpose warn "crates belong to a trade: a house, a stall, a pier, a cart, a workshop"
  for crates | crates_open
  when outdoor
  need near(3, #work)

rule market.street warn "a stall opens onto a street or a square"
  for #market
  need front(2, #path) or near(1, #path)

# ---------- Nature — biome rules (Minecraft's biome filter and can_survive) ----------

rule dry.land error "nothing stands in water but boats, buoys, lilies, sea rocks and decks"
  for *
  unless is(#afloat | deck) or on(deck)
  need not touches(#water)

rule water.afloat error "a buoy, lilies or a floating lantern float on water"
  for buoy | water_lilies | floating_lantern
  need on(#water)

rule water.boat error "a boat is on the water, or beached on the sand by it"
  for boat | ferry
  need near(1, #water) or (on(tile:s) and near(3, #water))

rule water.reeds warn "reeds grow at the waterline"
  for reeds
  unless has(band) or near(1, edge)
  need near(2, wet)

rule water.sea-rock warn "sea rocks stand in or by the sea"
  for rock_sea | tidepool
  unless near(1, edge)
  need near(2, wet)

rule harbour.gear warn "pots, nets and bollards stay by the water"
  for crab_pots | net_rack | bollard
  when outdoor
  need near(4, #water | #harbour)

rule bees.flowers warn "a beehive keeps within reach of flowers"
  for beehive
  need near(4, #blooms)

rule fire.clear warn "no tree overhangs a campfire"
  for campfire
  need count(1, #tree) == 0

rule tree.off-path error "a tree never grows on a path, a square or a deck"
  for #tree
  need not touches(#paved)

rule scatter.off-path warn "bushes, flowers, reeds and rocks never grow on a path, a square or a deck"
  for #scatter
  unless has(band)
  need not touches(#paved)

rule mine.cart warn "a minecart sits on its rails"
  for minecart
  when outdoor
  need near(1, rail)

rule fence.end warn "a fence end finishes a fence"
  for fence_end | wall_dry_end
  need near(1, tile:f)

rule biome.ember warn "ash pines, vents and cullet belong to the Emberlands (or a transition band toward them)"
  for ash_pine | ember_vent | cullet
  when outdoor
  unless has(band)
  need region(ember)

rule biome.basalt warn "basalt belongs to the Emberlands and the Storm coast (or a band toward them)"
  for rock_basalt
  when outdoor
  unless has(band)
  need region(ember | storm)

rule biome.willow warn "willows belong to the Dreamwater (or a band toward it)"
  for willow
  when outdoor
  unless has(band)
  need region(dream)

# ---------- Ground — the heightmap ----------

rule ground.rest warn "a prop rests on the ground: its y is the floor under it (a digit tile is that many metres up)"
  for *
  unless is(#raised)
  need grounded

rule ground.flat info "a prop's footprint sits on one floor height, not across a cliff edge"
  for #house | #market | bench | #at_table
  need flat
