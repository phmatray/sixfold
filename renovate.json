{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>phmatray/.github:renovate-base"
  ],
  "customManagers": [
    {
      "description": "three.js shipped in web/vendor/three: bump the version, then re-run tools/vendor-three.sh",
      "customType": "regex",
      "managerFilePatterns": ["/^tools/vendor-three\\.sh$/"],
      "matchStrings": ["THREE_VERSION=\\$\\{1:-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\}"],
      "depNameTemplate": "three",
      "datasourceTemplate": "npm"
    },
    {
      "description": "postprocessing shipped in web/vendor/postprocessing (#225): bump the version, then re-run tools/vendor-three.sh",
      "customType": "regex",
      "managerFilePatterns": ["/^tools/vendor-three\\.sh$/"],
      "matchStrings": ["POSTPROCESSING_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "postprocessing",
      "datasourceTemplate": "npm"
    },
    {
      "description": "N8AO shipped in web/vendor/n8ao (#225): bump the version, then re-run tools/vendor-three.sh",
      "customType": "regex",
      "managerFilePatterns": ["/^tools/vendor-three\\.sh$/"],
      "matchStrings": ["N8AO_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "n8ao",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Theatre.js core shipped in web/vendor/theatre: bump the version, then re-run tools/vendor-theatre.sh",
      "customType": "regex",
      "managerFilePatterns": ["/^tools/vendor-theatre\\.sh$/"],
      "matchStrings": ["THEATRE_VERSION=\\$\\{1:-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\}"],
      "depNameTemplate": "@theatre/core",
      "datasourceTemplate": "npm"
    }
  ]
}
