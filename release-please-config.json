{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "$comment": "`simple` rather than `rust`: the root is a Cargo workspace whose version lives in [workspace.package]; the crates inherit it, and Cargo.lock pins both. Tags stay plain vX.Y.Z.",
      "release-type": "simple",
      "release-as": "1.0.0",
      "package-name": "sixfold",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'sixfold-engine')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'sixfold-web')].version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Changed" },
        { "type": "revert", "section": "Reverted" },
        { "type": "docs", "section": "Documentation" },
        { "type": "build", "section": "Changed" },
        { "type": "ci", "section": "Changed" },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "style", "section": "Miscellaneous", "hidden": true },
        { "type": "test", "section": "Miscellaneous", "hidden": true }
      ]
    }
  }
}
